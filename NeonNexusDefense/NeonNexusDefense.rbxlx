<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="ReplicatedStorage" Referent="RBX000019"><Properties><string name="Name">ReplicatedStorage</string></Properties><Children><Item class="Folder" Referent="RBX000011"><Properties><string name="Name">Modules</string></Properties><Children><Item class="Folder" Referent="RBX000002"><Properties><string name="Name">Enemy</string></Properties><Children><Item class="ModuleScript" Referent="RBX000001"><Properties><string name="Name">Enemy</string><ProtectedString name="Source">--!strict
-- Enemy.lua — ООП-класс врага с движением по статическим waypoints.
-- ReplicatedStorage.Modules.Enemy.Enemy
--
-- Идея оптимизации: путь предрассчитан один раз (PathRuntime), массив кумулятивных
-- дистанций позволяет по travelledDistance за O(log n) найти сегмент и интерполировать
-- позицию. Никаких BodyPosition/AlignCFrame/PathfindingService на каждого врага.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

export type WaypointData = {
	positions: {Vector3},   -- точки пути
	cumulative: {number},   -- кумулятивные дистанции: cumulative[i] = длина пути до точки i
	totalLength: number,
}

export type Enemy = {
	-- публичные поля (для систем сервера)
	kind: Types.EnemyKind,
	model: Model,
	humanoidRoot: BasePart,
	maxHealth: number,
	health: number,
	baseSpeed: number,
	reward: number,
	flying: boolean,
	coreDamage: number,
	travelledDistance: number,
	alive: boolean,
	reachedEnd: boolean,

	-- приватные поля (leading underscore — конвенция «не трогать извне»)
	_path: WaypointData?,
	_slowUntil: number?,
	_slowPercent: number?,

	-- методы
	update: (self: Enemy, dt: number) -&gt; (),
	takeDamage: (self: Enemy, amount: number, source: Instance?) -&gt; boolean,
	applySlow: (self: Enemy, percent: number, duration: number) -&gt; (),
	getCurrentSpeed: (self: Enemy) -&gt; number,
	destroy: (self: Enemy) -&gt; (),
}

local EnemyClass = {}
EnemyClass.__index = EnemyClass

-- Бинарный поиск сегмента пути по дистанции
local function findSegment(cumulative: {number}, distance: number): number
	local lo, hi = 1, #cumulative - 1
	while lo &lt; hi do
		local mid = (lo + hi) // 2
		if cumulative[mid] &lt; distance then
			lo = mid + 1
		else
			hi = mid
		end
	end
	return lo
end

--- Фабрика врага. path — предрассчитанные waypoints; waveNumber — для скейлинга HP.
function EnemyClass.new(kind: Types.EnemyKind, waveNumber: number, path: WaypointData, archetype: Model, parent: Instance): Enemy
	local stats: Types.EnemyStats = Config.ENEMIES[kind]
	local hpMult = Config.SCALING.hp(waveNumber)
	local speedMult = Config.SCALING.speed(waveNumber)

	local model = archetype:Clone()
	local root = model:WaitForChild("HumanoidRootPart") :: BasePart
	model:PivotTo(CFrame.new(path.positions[1]))
	model.Parent = parent

	-- Анти-фликер: модель не участвует в физике, позиция ставим руками
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = true          -- важно: GetPartBoundsInRadius должен её видеть
			part.CanTouch = false
			part.CastShadow = false
			part.AssemblyLinearVelocity = Vector3.zero
		end
	end
	model:AddTag("Enemy")
	model:SetAttribute("Flying", stats.flying)
	model:SetAttribute("Travelled", 0)

	local self: Enemy = setmetatable({
		kind = kind,
		model = model,
		humanoidRoot = root,
		maxHealth = math.floor(stats.health * hpMult),
		health = math.floor(stats.health * hpMult),
		baseSpeed = stats.speed * speedMult,
		reward = stats.reward,
		flying = stats.flying,
		coreDamage = stats.coreDamage,
		travelledDistance = 0,
		alive = true,
		reachedEnd = false,
	}, EnemyClass)

	-- приватные данные храним в weak-tables вне публичного типа
	self._path = path
	self._slowUntil = 0
	self._slowPercent = 0
	return self
end

function EnemyClass.getCurrentSpeed(self: Enemy): number
	local now = os.clock()
	if now &lt; (self._slowUntil or 0) then
		local resist = Config.ENEMIES[self.kind].slowResist
		return self.baseSpeed * (1 - (self._slowPercent or 0) * (1 - resist))
	end
	return self.baseSpeed
end

function EnemyClass.applySlow(self: Enemy, percent: number, duration: number)
	if self.flying and self.kind == "Drone" then
		percent = math.min(percent, 0.3) -- дроны слабо замедляются
	end
	-- стаки: берём более сильный slow и продлеваем время
	self._slowPercent = math.max(self._slowPercent or 0, percent)
	self._slowUntil = math.max(self._slowUntil or 0, os.clock() + duration)
end

--- Вызывается серверным MovementSystem раз в ~30 Гц для всех живых врагов одним циклом.
function EnemyClass.update(self: Enemy, dt: number)
	if not self.alive then return end

	self.travelledDistance += self:getCurrentSpeed() * dt
	local path = self._path :: WaypointData

	if self.travelledDistance &gt;= path.totalLength then
		self.reachedEnd = true
		self.alive = false
		return
	end

	-- LUT-интерполяция позиции
	local seg = findSegment(path.cumulative, self.travelledDistance)
	local a, b = path.positions[seg], path.positions[seg + 1]
	local segLen = path.cumulative[seg + 1] - path.cumulative[seg]
	local alpha = if segLen &gt; 0 then (self.travelledDistance - path.cumulative[seg]) / segLen else 0
	local pos = a:Lerp(b, math.clamp(alpha, 0, 1))

	-- Летающие идут по «воздушной» высоте и срезают углы
	if self.flying then
		pos = pos + Vector3.new(0, 6, 0)
		self.model:PivotTo(CFrame.lookAt(pos, b + Vector3.new(0, 6, 0)))
	else
		self.model:PivotTo(CFrame.lookAt(pos, b))
	end

	self.model:SetAttribute("Travelled", self.travelledDistance) -- для таргетинга First/Last
end

--- Возвращает true, если враг умер от этого урона.
function EnemyClass.takeDamage(self: Enemy, amount: number, _source: Instance?): boolean
	if not self.alive then return false end
	self.health -= amount
	if self.health &lt;= 0 then
		self.health = 0
		self.alive = false
		return true
	end
	return false
end

function EnemyClass.destroy(self: Enemy)
	self._path = nil
	self._slowUntil = nil
	self._slowPercent = nil
end

return EnemyClass
</ProtectedString></Properties></Item></Children></Item><Item class="Folder" Referent="RBX000005"><Properties><string name="Name">Projectile</string></Properties><Children><Item class="ModuleScript" Referent="RBX000003"><Properties><string name="Name">Pool</string><ProtectedString name="Source">--!strict
-- Pool.lua — generic object pool для моделей (враги, снаряды, VFX).
-- ReplicatedStorage.Modules.Projectile.Pool
--
-- Проблема без пула: на каждой волне сотни Instance.new/Clone + Destroy -&gt;
-- spikes сборщика мусора и просадки репликации. Пул переиспользует модели:
-- Release() убирает их в «карман» ниже карты (Parent = storage), Get() достаёт.

export type Pool = {
	get: (self: Pool) -&gt; Model?,           -- nil, если пул пуст (создавайте через prefill)
	release: (self: Pool, obj: Model) -&gt; (),
	size: (self: Pool) -&gt; number,
	prefill: (self: Pool, count: number) -&gt; (),
}

local PoolClass = {}
PoolClass.__index = PoolClass

--- archetype: шаблон-модель (ReplicatedStorage.Asets...), storage: хранилище неактивных объектов
function PoolClass.new(archetype: Model, storage: Folder, maxIdle: number?): Pool
	local self = setmetatable({
		_archetype = archetype,
		_storage = storage,
		_free = {} :: {Model},
		_maxIdle = maxIdle or 50,
	}, PoolClass) :: any
	return self :: Pool
end

function PoolClass.get(self: Pool): Model?
	local free = (self :: any)._free :: {Model}
	local n = #free
	if n == 0 then
		return nil -- пул исчерпан: сервер должен создать новый или дождаться release
	end
	local obj = free[n]
	table.remove(free)
	obj:PivotTo(CFrame.identity)
	return obj
end

function PoolClass.release(self: Pool, obj: Model)
	local free = (self :: any)._free :: {Model}
	if #free &gt;= (self :: any)._maxIdle then
		obj:Destroy() -- пул переполнен — реально удаляем
		return
	end
	-- чистим состояние перед возвратом в пул
	for _, d in obj:GetDescendants() do
		if d:IsA("BasePart") then
			d.AssemblyLinearVelocity = Vector3.zero
			d.AssemblyAngularVelocity = Vector3.zero
		end
	end
	obj.Parent = (self :: any)._storage :: Folder
	table.insert(free, obj)
end

function PoolClass.size(self: Pool): number
	return #(self :: any)._free :: {Model}
end

--- Предзаполнение: вызывается на запуске сервера, чтобы первые волны были без аллокаций
function PoolClass.prefill(self: Pool, count: number)
	for _ = 1, count do
		local clone = ((self :: any)._archetype :: Model):Clone()
		clone.Parent = (self :: any)._storage :: Folder
		table.insert((self :: any)._free :: {Model}, clone)
	end
end

return PoolClass
</ProtectedString></Properties></Item><Item class="ModuleScript" Referent="RBX000004"><Properties><string name="Name">Projectile</string><ProtectedString name="Source">--!strict
-- Projectile.lua — снаряд с линейным лерпом (без физики) и пулингом.
-- ReplicatedStorage.Modules.Projectile.Projectile
--
-- Снаряд летит из точки A в предсказанную точку B с постоянной скоростью;
-- по прибытии вызывает onHit(origin, targetPosition). Модель берётся из Pool.

local Types = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules")
	:WaitForChild("Shared"):WaitForChild("Types"))
local PoolModule = require(script.Parent:WaitForChild("Pool"))
local EnemyModule = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules")
	:WaitForChild("Enemy"):WaitForChild("Enemy"))

type Enemy = EnemyModule.Enemy

export type Projectile = {
	active: boolean,
	from: Vector3,
	to: Vector3,
	speed: number,
	travelled: number,
	distance: number,
	model: Model?,
	onHit: (from: Vector3, to: Vector3, target: Enemy?) -&gt; (),
	target: Types.EnemyKind?,
	_targetRef: Enemy?,
}

local ProjectileClass = {}
ProjectileClass.__index = ProjectileClass

local projectilePool: PoolModule.Pool? = nil

--- Инициализация пула снарядов (вызвать один раз в Main.server.lua)
function ProjectileClass.initPool(archetype: Model, storage: Folder)
	projectilePool = PoolModule.new(archetype, storage, 200)
	projectilePool:prefill(60)
end

function ProjectileClass.fire(
	from: Vector3,
	to: Vector3,
	speed: number,
	target: Enemy?,
	onHit: (from: Vector3, to: Vector3, target: Enemy?) -&gt; ()
): Projectile?
	if not projectilePool then error("Projectile.initPool was not called") end
	local model = projectilePool:get()
	if not model then return nil end -- пул пуст -&gt; graceful skip (визуал важнее, чем лаг)

	local dist = (to - from).Magnitude
	local self: Projectile = setmetatable({
		active = true,
		from = from,
		to = to,
		speed = speed,
		travelled = 0,
		distance = math.max(dist, 0.001),
		model = model,
		onHit = onHit,
		target = if target then target.kind else nil,
	}, ProjectileClass)

	model.Parent = workspace:FindFirstChild("Runtime") or workspace
	model:PivotTo(CFrame.lookAt(from, to))
	self._targetRef = target -- сохраняем ссылку: при попадании пересчитаем текущую позицию
	return self
end

--- Серверный тик: продвигает все активные снаряды. Возвращает true, если снаряд завершился.
function ProjectileClass.update(self: Projectile, dt: number): boolean
	if not self.active then return true end
	self.travelled += self.speed * dt
	local t = self.travelled / self.distance

	if t &gt;= 1 then
		self.active = false
		local target = self._targetRef
		self.onHit(self.from, self.to, target)
		if self.model and projectilePool then
			projectilePool:release(self.model)
		end
		self.model = nil
		self._targetRef = nil
		return true
	end

	-- позиционируем снаряд по пути
	if self.model then
		self.model:PivotTo(CFrame.lookAt(self.from:Lerp(self.to, t), self.to))
	end
	return false
end

return ProjectileClass
</ProtectedString></Properties></Item></Children></Item><Item class="Folder" Referent="RBX000008"><Properties><string name="Name">Shared</string></Properties><Children><Item class="ModuleScript" Referent="RBX000006"><Properties><string name="Name">Config</string><ProtectedString name="Source">--!strict
-- Config.lua — единый источник баланса (ReplicatedStorage.Modules.Shared).
-- Сервер и клиент require-ят один модуль =&gt; цифры всегда синхронны.

local Types = require(script.Parent.Types)

local Config = {
	GAME = {
		STARTING_GOLD = 300,
		CORE_HP = 20,
		TOTAL_WAVES = 30,
		INTERMISSION_TIME = 15,
		EARLY_CALL_BONUS = 25,
		WAVE_BONUS_BASE = 50,
		WAVE_BONUS_PER_WAVE = 10,
		INTEREST_RATE = 0.05,
		INTEREST_CAP = 150,
		SELL_REFUND_RATIO = 0.6,
		TOWER_TICK_HZ = 10,          -- частота тика башен (сек 0.1)
		MOVE_TICK_DT = 1 / 30,       -- серверный цикл движения врагов
	},

	-- Множители сложности по номеру волны
	SCALING = {
		hp = function(wave: number): number
			return 1 + 0.18 * wave + 0.006 * wave ^ 2
		end,
		speed = function(wave: number): number
			return math.min(1 + 0.012 * wave, 1.45)
		end,
		reward = function(wave: number): number
			return 1 + 0.02 * wave
		end,
	},

	ENEMIES = {
		Runner = { health = 45, speed = 12, reward = 8, flying = false, coreDamage = 1, slowResist = 0 } :: Types.EnemyStats,
		Golem  = { health = 320, speed = 4.5, reward = 25, flying = false, coreDamage = 2, slowResist = 0.5 } :: Types.EnemyStats,
		Drone  = { health = 90, speed = 9, reward = 15, flying = true, coreDamage = 1, slowResist = 0 } :: Types.EnemyStats,
		Boss   = { health = 2560, speed = 3.5, reward = 200, flying = false, coreDamage = 5, slowResist = 0.8 } :: Types.EnemyStats,
	} :: { [Types.EnemyKind]: Types.EnemyStats },

	TOWERS = {
		Pulse = { cost = 100, damage = 22, cooldown = 0.6, range = 16, splashRadius = 0,
		          slowPercent = 0, slowDuration = 0, pierce = 0, defaultTarget = "First",
		          hitscan = false, canHitAir = true } :: Types.TowerStats,
		Mortar = { cost = 250, damage = 35, cooldown = 1.6, range = 20, splashRadius = 6,
		          slowPercent = 0, slowDuration = 0, pierce = 0, defaultTarget = "First",
		          hitscan = false, canHitAir = false } :: Types.TowerStats,
		Cryo = { cost = 180, damage = 8, cooldown = 0.9, range = 14, splashRadius = 0,
		          slowPercent = 0.45, slowDuration = 2, pierce = 0, defaultTarget = "Strongest",
		          hitscan = false, canHitAir = true } :: Types.TowerStats,
		Railgun = { cost = 400, damage = 180, cooldown = 2.8, range = 34, splashRadius = 0,
		          slowPercent = 0, slowDuration = 0, pierce = 1, defaultTarget = "Strongest",
		          hitscan = true, canHitAir = true } :: Types.TowerStats,
	} :: { [Types.TowerKind]: Types.TowerStats },

	UPGRADE = {
		DAMAGE_MULT = 1.75,
		RANGE_MULT = 1.10,
		COOLDOWN_MULT = 0.90,
		COST_RATIOS = { 0.7, 1.2 }, -- цена апгрейда до L2 и L3 от базы
		MAX_LEVEL = 3,
	},
}

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" Referent="RBX000007"><Properties><string name="Name">Types</string><ProtectedString name="Source">--!strict
-- Types.lua — общие типы для Neon Nexus Defense (ReplicatedStorage.Modules.Shared)

export type EnemyKind = "Runner" | "Golem" | "Drone" | "Boss"
export type TowerKind = "Pulse" | "Mortar" | "Cryo" | "Railgun"
export type TargetMode = "First" | "Last" | "Strongest" | "Weakest"

export type EnemyStats = {
	health: number,
	speed: number,          -- studs/sec
	reward: number,         -- базовое золото
	flying: boolean,        -- игнорирует ground-only таргетинг Mortar
	coreDamage: number,     -- урон ядру при доходе
	slowResist: number,     -- 0..1, доля иммунитета к замедлению
}

export type TowerStats = {
	cost: number,
	damage: number,
	cooldown: number,       -- сек между выстрелами
	range: number,          -- studs
	splashRadius: number,   -- 0 = без AoE
	slowPercent: number,    -- 0 = не стадит
	slowDuration: number,
	pierce: number,         -- снайпер: доп. цели на линии
	defaultTarget: TargetMode,
	hitscan: boolean,
	canHitAir: boolean,
}

export type WaveGroup = {
	kind: EnemyKind,
	count: number,
	interval: number,       -- сек между спавнами в группе
	startDelay: number,     -- запуск группы относительно начала волны
}

export type WaveDefinition = {
	groups: {WaveGroup},
}

return {
	EnemyKind = nil :: any, -- type-only placeholder (не используется в рантайме)
}
</ProtectedString></Properties></Item></Children></Item><Item class="Folder" Referent="RBX000010"><Properties><string name="Name">Tower</string></Properties><Children><Item class="ModuleScript" Referent="RBX000009"><Properties><string name="Name">Tower</string><ProtectedString name="Source">--!strict
-- Tower.lua — ООП-класс башни: поиск цели через Spatial Query API и стрельба.
-- ReplicatedStorage.Modules.Tower.Tower
--
-- Ключевая оптимизация: вместо перебора всех врагов (O(N) на каждую башню каждый кадр)
-- используем workspace:GetPartBoundsInRadius — движковый broadphase-запрос за ~O(log N).
-- Таргетинг First/Last строится на атрибуте "Travelled" (пишет Enemy.update),
-- Strongest/Weakest — на атрибуте "Health".

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local EnemyModule = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Enemy"):WaitForChild("Enemy"))
local ProjectileModule = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Projectile"):WaitForChild("Projectile"))

type Enemy = EnemyModule.Enemy
type TowerKind = Types.TowerKind
type TargetMode = Types.TargetMode

export type Tower = {
	kind: TowerKind,
	level: number,
	model: Model,
	muzzle: BasePart,
	cellId: string,
	ownerUserId: number,
	targetMode: TargetMode,
	cooldownLeft: number,
	stats: Types.TowerStats, -- текущие статы с учётом апгрейдов
	totalInvested: number,

	-- приватные поля (конвенция: underscore = не трогать извне)
	_lastKill: { target: Enemy }?,

	upgrade: (self: Tower) -&gt; boolean,
	getUpgradeCost: (self: Tower) -&gt; number?,
	findTarget: (self: Tower, registry: { [BasePart]: Enemy }) -&gt; Enemy?,
	fireAt: (self: Tower, target: Enemy, registry: { [BasePart]: Enemy }) -&gt; (),
	tick: (self: Tower, dt: number, registry: { [BasePart]: Enemy }) -&gt; (),
}

local TowerClass = {}
TowerClass.__index = TowerClass

-- Переиспользуемый OverlapParams (не создаём новый каждый тик!)
local function makeOverlapParams(): OverlapParams
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {}
	params.MaxParts = 128
	return params
end
local _sharedParams = makeOverlapParams()

--- Реестр «живой» серверной логики: model part -&gt; Enemy object.
--- Заполняет WaveManager при спавне/смерти. Нужен, чтобы из Part (результат spatial query)
--- получить объект Enemy для нанесения урона.

function TowerClass.new(kind: TowerKind, model: Model, cellId: string, ownerUserId: number): Tower
	local muzzle = model:WaitForChild("Muzzle") :: BasePart
	local base = Config.TOWERS[kind]
	local self: Tower = setmetatable({
		kind = kind,
		level = 1,
		model = model,
		muzzle = muzzle,
		cellId = cellId,
		ownerUserId = ownerUserId,
		targetMode = base.defaultTarget,
		cooldownLeft = 0,
		totalInvested = base.cost,
		stats = table.clone(base),
	}, TowerClass)
	model:SetAttribute("TowerKind", kind)
	model:SetAttribute("Level", 1)
	return self
end

--- Пересчёт стата по уровню: damage ×1.75^L, range ×1.1^L, cooldown ×0.9^L
local function scaledStat(base: number, level: number, mult: number): number
	return base * mult ^ (level - 1)
end

function TowerClass.getUpgradeCost(self: Tower): number?
	if self.level &gt;= Config.UPGRADE.MAX_LEVEL then return nil end
	local ratio = Config.UPGRADE.COST_RATIOS[self.level]
	return math.floor(Config.TOWERS[self.kind].cost * ratio)
end

function TowerClass.upgrade(self: Tower): boolean
	local cost = self:getUpgradeCost()
	if not cost then return false end
	self.level += 1
	self.totalInvested += cost
	local base = Config.TOWERS[self.kind]
	self.stats.damage = scaledStat(base.damage, self.level, Config.UPGRADE.DAMAGE_MULT)
	self.stats.range = scaledStat(base.range, self.level, Config.UPGRADE.RANGE_MULT)
	self.stats.cooldown = scaledStat(base.cooldown, self.level, Config.UPGRADE.COOLDOWN_MULT)
	self.model:SetAttribute("Level", self.level)
	return true
end

--- Сортировка-выбор цели по режиму таргетинга среди кандидатов.
local function pickByMode(candidates: { {enemy: Enemy, travelled: number, health: number} }, mode: TargetMode): Enemy?
	local best: Enemy? = nil
	local bestKey = 0
	for _, c in candidates do
		local key: number
		if mode == "First" then key = c.travelled            -- дальше всех по пути
		elseif mode == "Last" then key = -c.travelled        -- ближе к спавну
		elseif mode == "Strongest" then key = c.health
		else key = -c.health end                              -- Weakest
		if best == nil or key &gt; bestKey then
			best, bestKey = c.enemy, key
		end
	end
	return best
end

--- Поиск цели: GetPartBoundsInRadius + фильтрация + выбор по таргет-моду.
function TowerClass.findTarget(self: Tower, registry: { [BasePart]: Enemy }): Enemy?
	local origin = self.muzzle.Position
	local range = self.stats.range

	-- SPATIAL QUERY API (современная замена Region3 / GetPartsInRegion3)
	local parts = workspace:GetPartBoundsInRadius(origin, range, _sharedParams)

	local candidates: { {enemy: Enemy, travelled: number, health: number} } = {}
	for _, part in parts do
		local enemy = registry[part]
		if enemy and enemy.alive then
			-- Mortar не бьёт летающих; остальные башни бьют всех
			if self.stats.canHitAir or not enemy.flying then
				table.insert(candidates, {
					enemy = enemy,
					travelled = enemy.travelledDistance,
					health = enemy.health,
				})
			end
		end
	end

	return pickByMode(candidates, self.targetMode)
end

--- Предсказание точки перехвата: куда враг придёт за время полёта снаряда.
local function predictPosition(target: Enemy, projSpeed: number, from: Vector3): Vector3
	local pos = target.model:GetPivot().Position
	local dist = (pos - from).Magnitude
	local leadTime = dist / projSpeed
	-- грубая предикция вдоль пути: + speed*leadTime дистанции =&gt; берём позицию чуть вперёд
	local ahead = math.min(target.travelledDistance + target:getCurrentSpeed() * leadTime, 1e9)
	local _ = ahead -- точная LUT-предикция делается в Enemy; здесь упрощённый lead
	return pos
end

function TowerClass.fireAt(self: Tower, target: Enemy, _registry: { [BasePart]: Enemy })
	local stats = self.stats
	local from = self.muzzle.Position

	if stats.hitscan then
		-- Railgun: мгновенный луч, урон сразу + pierce по линии
		local died = target:takeDamage(stats.damage, self.model)
		self._lastKill = died and { target = target } or nil
		-- TODO VFX Beam через RemoteEvent EnemyFX (клиенты рисуют линию от-&gt;до)
		return
	end

	local projSpeed = if self.kind == "Mortar" then 40 else 80
	local to = predictPosition(target, projSpeed, from)

	ProjectileModule.fire(from, to, projSpeed, target, function(_f, hitPos, tgt)
		if tgt and tgt.alive then
			if stats.splashRadius &gt; 0 then
				-- AoE: второй spatial query уже в точке взрыва
				local params = makeOverlapParams()
				local boomParts = workspace:GetPartBoundsInRadius(hitPos, stats.splashRadius, params)
				for _, p in boomParts do
					local e = _registry[p]
					if e and e.alive and (not e.flying) then
						e:takeDamage(stats.damage, self.model)
					end
				end
			else
				tgt:takeDamage(stats.damage, self.model)
			end
			if stats.slowPercent &gt; 0 then
				tgt:applySlow(stats.slowPercent, stats.slowDuration)
			end
		end
	end)
end

--- Тик вызывается TowerSystem раз в 0.1 сек для каждой башни.
function TowerClass.tick(self: Tower, dt: number, registry: { [BasePart]: Enemy })
	self.cooldownLeft -= dt
	if self.cooldownLeft &gt; 0 then return end

	local target = self:findTarget(registry)
	if target then
		self:fireAt(target, registry)
		self.cooldownLeft = self.stats.cooldown
	end
end

return TowerClass
</ProtectedString></Properties></Item></Children></Item></Children></Item></Children></Children></Item>
<Item class="ServerScriptService" Referent="RBX000020"><Properties><string name="Name">ServerScriptService</string></Properties><Children><Item class="Folder" Referent="RBX000015"><Properties><string name="Name">Server</string></Properties><Children><Item class="Script" Referent="RBX000012"><Properties><string name="Name">Main</string><ProtectedString name="Source">--!strict
-- Main.server.lua — bootstrap: создаёт Remotes, папки Runtime, запускает системы.
-- ВАЖНО: WaveManager требует существующие RemoteEvents, поэтому они создаются ЗДЕСЬ,
-- до require(WaveManager). В проде можно задать их прямо в Studio через Explorer.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

---------------------------------------------------------------------------
-- 1. Remotes (Folder ReplicatedStorage.Remotes)
---------------------------------------------------------------------------
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes") or Instance.new("Folder")
remotesFolder.Name = "Remotes"
remotesFolder.Parent = ReplicatedStorage

local function ensureRemote(name: string, className: string): Instance
	local existing = remotesFolder:FindFirstChild(name)
	if existing then return existing end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = remotesFolder
	return inst
end

ensureRemote("TowerActions", "RemoteEvent")     -- C-&gt;S: buy/upgrade/sell/setTarget
ensureRemote("WaveEvents", "RemoteEvent")       -- S-&gt;All: waveStarted/completed/countdown/gameOver
ensureRemote("EconomyUpdate", "RemoteEvent")    -- S-&gt;C: золотые события (только владельцу)
ensureRemote("EnemyFX", "RemoteEvent")          -- S-&gt;All: визуальные события
ensureRemote("RequestWaveStart", "RemoteFunction") -- C-&gt;S: early call

---------------------------------------------------------------------------
-- 2. Runtime-папки (Workspace)
---------------------------------------------------------------------------
local runtime = workspace:FindFirstChild("Runtime") or Instance.new("Folder")
runtime.Name = "Runtime"
runtime.Parent = workspace

for _, sub in { "EnemyPool", "ProjectilePool", "Towers" } do
	if not runtime:FindFirstChild(sub) then
		local f = Instance.new("Folder")
		f.Name = sub
		f.Parent = runtime
	end
end

---------------------------------------------------------------------------
-- 3. Экономика (общий co-op банк; серверный авторитет)
---------------------------------------------------------------------------
local EconomyManager = {}
EconomyManager.gold = 0 :: number

local TowerActions = remotesFolder:WaitForChild("TowerActions") :: RemoteEvent
local EconomyUpdate = remotesFolder:WaitForChild("EconomyUpdate") :: RemoteEvent

local function broadcastGold()
	for _, player in game:GetService("Players"):GetPlayers() do
		EconomyUpdate:FireClient(player, "set", EconomyManager.gold)
	end
end

game:GetService("Players").PlayerAdded:Connect(function()
	task.delay(0.5, broadcastGold) -- отдать текущий баланс новому игроку
end)

EconomyUpdate.OnServerEvent:Connect(function(_player, kind: string, amount: number)
	-- этот канал используется ТОЛЬКО сервером на запись; входящие игнорируем (анти-exploit)
end)

-- Реальный источник начислений — вызовы из WaveManager идут через FireClient выше;
-- для однопользовательского банка слушаем собственный сигнал:
local function award(amount: number)
	EconomyManager.gold += amount
	broadcastGold()
end
local function trySpend(amount: number): boolean
	if EconomyManager.gold &lt; amount then return false end
	EconomyManager.gold -= amount
	broadcastGold()
	return true
end

---------------------------------------------------------------------------
-- 4. Башни: реестр клеток + обработка действий клиента с полной валидацией
---------------------------------------------------------------------------
local Modules = ReplicatedStorage:WaitForChild("Modules")
local Config = require(Modules:WaitForChild("Shared"):WaitForChild("Config"))
local Types = require(Modules:WaitForChild("Shared"):WaitForChild("Types"))
local TowerModule = require(Modules:WaitForChild("Tower"):WaitForChild("Tower"))

type TowerKind = Types.TowerKind

local towersByCell: { [string]: TowerModule.Tower } = {}
local towerArchetypes = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Towers")
local towersFolder = runtime:WaitForChild("Towers")

-- rate-limit против спама запросами
local lastActionAt: { [number]: number } = {}
local function rateLimited(userId: number): boolean
	local now = os.clock()
	if now - (lastActionAt[userId] or 0) &lt; 0.15 then return true end
	lastActionAt[userId] = now
	return false
end

TowerActions.OnServerEvent:Connect(function(player: Player, action: string, ...)
	if rateLimited(player.UserId) then return end
	local args = { ... }

	if action == "buy" then
		local kind, cellId = args[1] :: TowerKind, args[2] :: string
		local cell = workspace:FindFirstChild("BuildGrid"):FindFirstChild(cellId)
		if not cell then return end                                  -- клетки с таким id нет
		if towersByCell[cellId] then return end                      -- клетка занята
		if (cell.Position - player.Character:GetPivot().Position).Magnitude &gt; 60 then
			return                                                   -- слишком далеко от строителя
		end
		local cost = Config.TOWERS[kind].cost
		if not trySpend(cost) then return end                        -- не хватает золота

		local archetype = towerArchetypes:FindFirstChild(kind) :: Model?
		if not archetype then return end
		local model = archetype:Clone()
		model:PivotTo(cell.CFrame)
		model.Parent = towersFolder

		local tower = TowerModule.new(kind, model, cellId, player.UserId)
		tower.totalInvested = cost
		towersByCell[cellId] = tower

	elseif action == "upgrade" then
		local cellId = args[1] :: string
		local tower = towersByCell[cellId]
		if not tower then return end
		local cost = tower:getUpgradeCost()
		if cost and trySpend(cost) then
			tower:upgrade()
		end

	elseif action == "sell" then
		local cellId = args[1] :: string
		local tower = towersByCell[cellId]
		if not tower then return end
		award(math.floor(tower.totalInvested * Config.GAME.SELL_REFUND_RATIO))
		towersByCell[cellId] = nil
		tower.model:Destroy()

	elseif action == "setTarget" then
		local cellId, mode = args[1] :: string, args[2] :: Types.TargetMode
		local tower = towersByCell[cellId]
		if tower and (mode == "First" or mode == "Last" or mode == "Strongest" or mode == "Weakest") then
			tower.targetMode = mode
		end
	end
end)

---------------------------------------------------------------------------
-- 5. TowerSystem: тик всех башен 10 Гц (registry даёт WaveManager)
---------------------------------------------------------------------------
task.spawn(function()
	-- ждём появления реестра от WaveManager
	local registry: { [BasePart]: any }? = nil
	repeat
		task.wait(0.5)
		registry = _G.NND_partRegistry
	until registry ~= nil

	while true do
		task.wait(1 / Config.GAME.TOWER_TICK_HZ)
		for _, tower in towersByCell do
			tower:tick(1 / Config.GAME.TOWER_TICK_HZ, registry :: any)
		end
	end
end)

---------------------------------------------------------------------------
-- 6. Запуск волновой системы
---------------------------------------------------------------------------
require(script:WaitForChild("WaveManager"))
print("[NND] Server bootstrap complete")
</ProtectedString></Properties></Item><Item class="ModuleScript" Referent="RBX000013"><Properties><string name="Name">PathRuntime</string><ProtectedString name="Source">--!strict
-- PathRuntime.lua — предрассчёт статического пути из Part'ов Workspace.Waypoints.
-- Вызывается ОДИН раз при старте сервера; дальше только читается.
-- Если путь станет динамическим (мазы, разрушаемые мосты) — сюда же встраивается
-- PathfindingService:CreatePath(AgentParams) + PathModifiers, но для TD это избыточно.

local waypointsFolder = workspace:WaitForChild("Waypoints")

export type PathData = {
	positions: {Vector3},
	cumulative: {number},
	totalLength: number,
}

local PathRuntime = {}
local cached: PathData? = nil

function PathRuntime.precompute(): PathData
	-- сортируем части по имени W1, W2, ... (числовой суффикс)
	local parts: {Part} = {}
	for _, obj in waypointsFolder:GetChildren() do
		if obj:IsA("BasePart") then
			table.insert(parts, obj :: Part)
		end
	end
	table.sort(parts, function(a, b)
		local na = tonumber(a.Name:gmatch("%d+")()) or 0
		local nb = tonumber(b.Name:gmatch("%d+")()) or 0
		return na &lt; nb
	end)

	local positions: {Vector3} = {}
	local cumulative: {number} = {}
	local total = 0
	for i, part in parts do
		table.insert(positions, part.Position)
		if i == 1 then
			table.insert(cumulative, 0)
		else
			total += (positions[i] - positions[i - 1]).Magnitude
			table.insert(cumulative, total)
		end
	end

	cached = { positions = positions, cumulative = cumulative, totalLength = total }
	return cached
end

function PathRuntime.getPath(): PathData
	if not cached then return PathRuntime.precompute() end
	return cached
end

return PathRuntime
</ProtectedString></Properties></Item><Item class="Script" Referent="RBX000014"><Properties><string name="Name">WaveManager</string><ProtectedString name="Source">--!strict
-- WaveManager.server.lua — генератор волн, спавн врагов, цикл движения и начисление наград.
-- ServerScriptService.Server.WaveManager
--
-- Поток данных:
--   WaveManager --spawn--&gt; Enemy (через класс Enemy) + registry[part] = enemy
--   Movement loop (1 цикл на 30 Гц для ВСЕХ врагов; не Heartbeat на врага!)
--   Смерть -&gt; EconomyManager.awardKill(ownerless: shared co-op pool) -&gt; gold
--   Дошёл до конца -&gt; урон ядру; все группы отработаны и поле пусто -&gt; waveCompleted

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Players = game:GetService("Players")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Shared = Modules:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))
local EnemyModule = require(Modules:WaitForChild("Enemy"):WaitForChild("Enemy"))
local ProjectileModule = require(Modules:WaitForChild("Projectile"):WaitForChild("Projectile"))

type EnemyKind = Types.EnemyKind
type WaypointData = EnemyModule.WaypointData
type Enemy = EnemyModule.Enemy

local Server = ServerScriptService:WaitForChild("Server")
local PathRuntime = require(Server:WaitForChild("PathRuntime"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local WaveEvents = Remotes:WaitForChild("WaveEvents") :: RemoteEvent
local EconomyUpdate = Remotes:WaitForChild("EconomyUpdate") :: RemoteEvent
local RequestWaveStart = Remotes:WaitForChild("RequestWaveStart") :: RemoteFunction

---------------------------------------------------------------------------
-- Состояние
---------------------------------------------------------------------------
local activeEnemies: { [Enemy]: boolean } = {}      -- множество живых объектов
local partRegistry: { [BasePart]: Enemy } = {}      -- part -&gt; Enemy (для башен/AoE)
local projectiles: { ProjectileModule.Projectile } = {}

local currentWave = 0
local inIntermission = true
local coreHP = Config.GAME.CORE_HP
local gameOver = false

local runtimeFolder = workspace:WaitForChild("Runtime")
local enemyStorage = runtimeFolder:WaitForChild("EnemyPool")   -- неактивные модели
local enemyArchetypes = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Enemies")

-- Пул моделей врагов: переиспользуем вместо Clone/Destroy каждый спавн
local PoolModule = require(Modules:WaitForChild("Projectile"):WaitForChild("Pool"))
local enemyPools: { [EnemyKind]: PoolModule.Pool } = {}
for kind, _ in Config.ENEMIES :: { [EnemyKind]: any } do
	local archetype = enemyArchetypes:FindFirstChild(kind) :: Model?
	if archetype then
		enemyPools[kind] = PoolModule.new(archetype, enemyStorage, 40)
		enemyPools[kind]:prefill(20)
	end
end

---------------------------------------------------------------------------
-- Генерация состава волны (процедурно по правилам GDD)
---------------------------------------------------------------------------
local function buildWave(wave: number): Types.WaveDefinition
	local groups: { Types.WaveGroup } = {}

	table.insert(groups, {
		kind = "Runner",
		count = 6 + math.floor(wave * 1.8),
		interval = math.max(0.35, 1.1 - wave * 0.02),
		startDelay = 0,
	})
	if wave &gt;= 4 then
		table.insert(groups, {
			kind = "Golem",
			count = 2 + math.floor((wave - 4) / 3),
			interval = 2.2,
			startDelay = 4,
		})
	end
	if wave &gt;= 7 then
		table.insert(groups, {
			kind = "Drone",
			count = 3 + math.floor((wave - 7) / 2),
			interval = 0.9,
			startDelay = 8,
		})
	end
	if wave % 10 == 0 then -- каждая 10-я волна — босс
		table.insert(groups, { kind = "Boss", count = wave // 10, interval = 12, startDelay = 10 })
	end

	return { groups = groups }
end

---------------------------------------------------------------------------
-- Спавн/смерть
---------------------------------------------------------------------------
local function despawnEnemy(enemy: Enemy, killedByTower: boolean)
	activeEnemies[enemy] = nil
	partRegistry[enemy.humanoidRoot] = nil
	enemy:destroy()

	if killedByTower then
		-- Награда делится на всех игроков (co-op общий банк волны)
		local reward = math.floor(enemy.reward * Config.SCALING.reward(currentWave))
		for _, player in Players:GetPlayers() do
			EconomyUpdate:FireClient(player, "+kill", reward)
		end
	end

	local pool = enemyPools[enemy.kind]
	if pool then
		pool:release(enemy.model)
	else
		enemy.model:Destroy()
	end
end

local function spawnEnemy(kind: EnemyKind)
	local path: WaypointData = PathRuntime.getPath()
	local pool = enemyPools[kind]
	local model = if pool then pool:get() else nil
	if not model then
		model = (enemyArchetypes:FindFirstChild(kind) :: Model):Clone()
	end

	local enemy = EnemyModule.new(kind, currentWave, path, model, runtimeFolder)
	activeEnemies[enemy] = true
	partRegistry[enemy.humanoidRoot] = enemy
end

---------------------------------------------------------------------------
-- Циклы: движение врагов + снаряды (ОДИН цикл на систему, не на сущность)
---------------------------------------------------------------------------
task.spawn(function()
	local dt = Config.GAME.MOVE_TICK_DT
	while not gameOver do
		task.wait(dt)

		-- движение
		for enemy in activeEnemies do
			enemy:update(dt)
			if not enemy.alive then
				if enemy.reachedEnd then
					coreHP -= enemy.coreDamage
					warn(`[WaveManager] Core hit! HP={coreHP}`)
					despawnEnemy(enemy, false)
				else
					despawnEnemy(enemy, true) -- умер от урона башни
				end
			end
		end

		-- снаряды
		local i = 1
		while i &lt;= #projectiles do
			if projectiles[i]:update(dt) then
				table.remove(projectiles, i)
			else
				i += 1
			end
		end

		if coreHP &lt;= 0 then
			gameOver = true
			WaveEvents:FireAllClients("gameOver", currentWave)
		end
	end
end)

-- Реестр part-&gt;enemy публикуем для TowerSystem (другой скрипт читает через эту таблицу)
_G.NND_partRegistry = partRegistry -- TODO: в проде заменить на Dependency Injection через Main

---------------------------------------------------------------------------
-- Волновой цикл
---------------------------------------------------------------------------
local function runWave(wave: number)
	currentWave = wave
	inIntermission = false
	WaveEvents:FireAllClients("waveStarted", wave)

	local definition = buildWave(wave)

	-- параллельные группы спавна
	local threadsRemaining = 0
	for _, group in definition.groups do
		threadsRemaining += 1
		task.spawn(function()
			task.delay(group.startDelay, function()
				for _ = 1, group.count do
					if gameOver then break end
					spawnEnemy(group.kind :: EnemyKind)
					task.wait(group.interval)
				end
				threadsRemaining -= 1
			end)
		end)
	end

	-- ждём: все заспавнены и все зачищены
	while threadsRemaining &gt; 0 and not gameOver do
		task.wait(0.2)
	end
	repeat
		local aliveCount = 0
		for _ in activeEnemies do aliveCount += 1 end
		task.wait(0.25)
	until aliveCount == 0 or gameOver

	if gameOver then return end

	-- бонус за волну + interest
	local bonus = Config.GAME.WAVE_BONUS_BASE + wave * Config.GAME.WAVE_BONUS_PER_WAVE
	for _, player in Players:GetPlayers() do
		EconomyUpdate:FireClient(player, "+waveBonus", bonus)
	end
	WaveEvents:FireAllClients("waveCompleted", wave, bonus)
end

local function intermission(seconds: number)
	inIntermission = true
	for t = seconds, 1, -1 do
		if gameOver then return end
		WaveEvents:FireAllClients("countdown", t)
		task.wait(1)
	end
end

-- Early call: клиент просит начать волну досрочно (только во время intermission)
RequestWaveStart.OnServerInvoke = function(player: Player)
	if not inIntermission or gameOver then return false end
	EconomyUpdate:FireClient(player, "+earlyCall", Config.GAME.EARLY_CALL_BONUS)
	return true
end

-- Главный игровой луп
task.spawn(function()
	PathRuntime.precompute() -- читаем Waypoints один раз при старте
	ProjectileModule.initPool(
		ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Projectiles"):WaitForChild("Bolt") :: Model,
		runtimeFolder:WaitForChild("ProjectilePool")
	)

	intermission(5) -- короткая пауза на билд перед волной 1
	local wave = 1
	while not gameOver do
		runWave(wave)
		if gameOver then break end
		if wave &gt;= Config.GAME.TOTAL_WAVES and wave % 10 ~= 0 then
			-- endless-режим после 30 волн продолжается бесконечно
		end
		intermission(Config.GAME.INTERMISSION_TIME)
		wave += 1
	end
end)
</ProtectedString></Properties></Item></Children></Item></Children></Children></Item>
<Item class="StarterPlayerScripts" Referent="RBX000021"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Children><Item class="Folder" Referent="RBX000018"><Properties><string name="Name">Client</string></Properties><Children><Item class="LocalScript" Referent="RBX000016"><Properties><string name="Name">HudController</string><ProtectedString name="Source">--!strict
-- HudController.client.lua — HUD: золото, HP ядра, волна, таймер, кнопка early-call.
-- StarterPlayerScripts.Client.HudController (LocalScript)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local localPlayer = Players.LocalPlayer

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local WaveEvents = Remotes:WaitForChild("WaveEvents") :: RemoteEvent
local EconomyUpdate = Remotes:WaitForChild("EconomyUpdate") :: RemoteEvent
local RequestWaveStart = Remotes:WaitForChild("RequestWaveStart") :: RemoteFunction

---------------------------------------------------------------------------
-- Построение UI кодом (в проде лучше класть ScreenGui в StarterGui и искать через Wait)
---------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "NND_Hud"
gui.ResetOnSpawn = false
gui.Parent = localPlayer:WaitForChild("PlayerGui")

local function makeLabel(name: string, text: string, pos: UDim2): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.Text = text
	l.Size = UDim2.new(0, 220, 0, 34)
	l.Position = pos
	l.BackgroundColor3 = Color3.fromRGB(15, 18, 30)
	l.BackgroundTransparency = 0.25
	l.TextColor3 = Color3.fromRGB(0, 255, 200) -- neon
	l.Font = Enum.Font.Code
	l.TextSize = 18
	l.Parent = gui
	return l
end

local goldLabel = makeLabel("Gold", "💰 0", UDim2.new(0, 16, 0, 16))
local waveLabel = makeLabel("Wave", "Wave: —", UDim2.new(0, 16, 0, 54))
local timerLabel = makeLabel("Timer", "", UDim2.new(0, 16, 0, 92))

local earlyBtn = Instance.new("TextButton")
earlyBtn.Name = "EarlyCall"
earlyBtn.Text = "⚡ START WAVE (+25g)"
earlyBtn.Size = UDim2.new(0, 200, 0, 40)
earlyBtn.Position = UDim2.new(0, 16, 0, 130)
earlyBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 90)
earlyBtn.TextColor3 = Color3.new(1, 1, 1)
earlyBtn.Visible = false
earlyBtn.Parent = gui

---------------------------------------------------------------------------
-- Состояние
---------------------------------------------------------------------------
local gold = 0

EconomyUpdate.OnClientEvent:Connect(function(kind: string, amount: number)
	if kind == "set" then
		gold = amount
	elseif kind == "+kill" or kind == "+waveBonus" or kind == "+earlyCall" then
		gold += amount
	end
	goldLabel.Text = `💰 {gold}`
end)

WaveEvents.OnClientEvent:Connect(function(event: string, a: number?, _b: number?)
	if event == "waveStarted" then
		waveLabel.Text = `Wave: {a} ⚔️`
		timerLabel.Text = ""
		earlyBtn.Visible = false
	elseif event == "countdown" then
		timerLabel.Text = `Следующая волна: {a}с`
		earlyBtn.Visible = true
	elseif event == "waveCompleted" then
		waveLabel.Text = `Wave {a} cleared! +{_b}g`
	elseif event == "gameOver" then
		timerLabel.Text = `☠ CORE BREACHED at wave {a}`
		earlyBtn.Visible = false
	end
end)

earlyBtn.Activated:Connect(function()
	local ok = RequestWaveStart:InvokeServer()
	if ok then
		earlyBtn.Visible = false
		timerLabel.Text = "Волна вызвана досрочно!"
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" Referent="RBX000017"><Properties><string name="Name">PlacementUI</string><ProtectedString name="Source">--!strict
-- PlacementUI.client.lua — выбор клетки и башни, «призрак», отправка намерений серверу.
-- Клиент НИКОГДА не решает сам, можно ли строить: он лишь шлёт (kind, cellId),
-- сервер валидирует (Main.server.lua). Призрак — чисто визуальный фидбек.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Types = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Shared"):WaitForChild("Types"))
local localPlayer = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Shared"):WaitForChild("Config"))
local TowerActions = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TowerActions") :: RemoteEvent

---------------------------------------------------------------------------
-- Панель выбора башни (упрощённо — 4 кнопки)
---------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "NND_Build"
gui.ResetOnSpawn = false
gui.Parent = localPlayer:WaitForChild("PlayerGui")

local bar = Instance.new("Frame")
bar.Size = UDim2.new(0, 440, 0, 70)
bar.Position = UDim2.new(0.5, -220, 1, -90)
bar.BackgroundColor3 = Color3.fromRGB(12, 14, 24)
bar.Parent = gui

local selectedKind: Types.TowerKind? = nil

local x = 4
for _, kind in { "Pulse", "Mortar", "Cryo", "Railgun" } do
	local stats = Config.TOWERS[kind]
	local btn = Instance.new("TextButton")
	btn.Name = kind
	btn.Text = `{kind}\n{stats.cost}g`
	btn.Size = UDim2.new(0, 105, 0, 62)
	btn.Position = UDim2.new(0, x, 0, 4)
	btn.BackgroundColor3 = Color3.fromRGB(30, 36, 60)
	btn.TextColor3 = Color3.fromRGB(0, 230, 255)
	btn.AutoButtonColor = true
	btn.Parent = bar
	x += 110

	btn.Activated:Connect(function()
		selectedKind = kind :: Types.TowerKind
		for _, sib in bar:GetChildren() do
			if sib:IsA("TextButton") then
				sib.BackgroundColor3 = if sib == btn
					then Color3.fromRGB(0, 120, 100) else Color3.fromRGB(30, 36, 60)
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Raycast по сетке + призрак
---------------------------------------------------------------------------
local ghost: Model? = nil
local currentCell: BasePart? = nil

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

local function refreshGhost()
	local mousePos = UserInputService:GetMouseLocation()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local ray = camera:ScreenPointToRay(mousePos.X, mousePos.Y)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 500, params)

	currentCell = nil
	if hit and hit.Instance.Name:match("^Cell_") and selectedKind then
		currentCell = hit.Instance
		if not ghost then
			ghost = (ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Towers")
				:WaitForChild(selectedKind) :: Model):Clone()
			for _, p in ghost:GetDescendants() do
				if p:IsA("BasePart") then
					p.Transparency = 0.5
					p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
				end
			end
			ghost.Parent = workspace
		end
		ghost:PivotTo(currentCell.CFrame)
	else
		if ghost then ghost:Destroy(); ghost = nil end
	end
end

RunService.RenderStepped:Connect(refreshGhost)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
	if selectedKind and currentCell then
		-- отправляем НАМЕРЕНИЕ; сервер проверит деньги/дальность/занятость
		TowerActions:FireServer("buy", selectedKind, currentCell.Name)
	end
end)
</ProtectedString></Properties></Item></Children></Item></Children></Children></Item>
</roblox>
