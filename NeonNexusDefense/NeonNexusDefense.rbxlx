<?xml version="1.0" encoding="utf-8"?>
<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<classmain class="ReplicatedStorage"><Item class="ReplicatedStorage" Referent="RBX000019"><Properties><string name="Name">ReplicatedStorage</string></Properties><Children><Item class="Folder" Referent="RBX000011"><Properties><string name="Name">Modules</string></Properties><Children><Item class="Folder" Referent="RBX000002"><Properties><string name="Name">Enemy</string></Properties><Children><Item class="ModuleScript" Referent="RBX000001"><Properties><string name="Name">Enemy</string><ProtectedString name="Source">--!strict_x000A_-- Enemy.lua — ООП-класс врага с движением по статическим waypoints._x000A_-- ReplicatedStorage.Modules.Enemy.Enemy_x000A_--_x000A_-- Идея оптимизации: путь предрассчитан один раз (PathRuntime), массив кумулятивных_x000A_-- дистанций позволяет по travelledDistance за O(log n) найти сегмент и интерполировать_x000A_-- позицию. Никаких BodyPosition/AlignCFrame/PathfindingService на каждого врага._x000A__x000A_local ReplicatedStorage = game:GetService("ReplicatedStorage")_x000A_local Shared = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Shared")_x000A_local Config = require(Shared:WaitForChild("Config"))_x000A_local Types = require(Shared:WaitForChild("Types"))_x000A__x000A_export type WaypointData = {_x000A__x0009_positions: {Vector3},   -- точки пути_x000A__x0009_cumulative: {number},   -- кумулятивные дистанции: cumulative[i] = длина пути до точки i_x000A__x0009_totalLength: number,_x000A_}_x000A__x000A_export type Enemy = {_x000A__x0009_-- публичные поля (для систем сервера)_x000A__x0009_kind: Types.EnemyKind,_x000A__x0009_model: Model,_x000A__x0009_humanoidRoot: BasePart,_x000A__x0009_maxHealth: number,_x000A__x0009_health: number,_x000A__x0009_baseSpeed: number,_x000A__x0009_reward: number,_x000A__x0009_flying: boolean,_x000A__x0009_coreDamage: number,_x000A__x0009_travelledDistance: number,_x000A__x0009_alive: boolean,_x000A__x0009_reachedEnd: boolean,_x000A__x000A__x0009_-- приватные поля (leading underscore — конвенция «не трогать извне»)_x000A__x0009__path: WaypointData?,_x000A__x0009__slowUntil: number?,_x000A__x0009__slowPercent: number?,_x000A__x000A__x0009_-- методы_x000A__x0009_update: (self: Enemy, dt: number) -&gt; (),_x000A__x0009_takeDamage: (self: Enemy, amount: number, source: Instance?) -&gt; boolean,_x000A__x0009_applySlow: (self: Enemy, percent: number, duration: number) -&gt; (),_x000A__x0009_getCurrentSpeed: (self: Enemy) -&gt; number,_x000A__x0009_destroy: (self: Enemy) -&gt; (),_x000A_}_x000A__x000A_local EnemyClass = {}_x000A_EnemyClass.__index = EnemyClass_x000A__x000A_-- Бинарный поиск сегмента пути по дистанции_x000A_local function findSegment(cumulative: {number}, distance: number): number_x000A__x0009_local lo, hi = 1, #cumulative - 1_x000A__x0009_while lo &lt; hi do_x000A__x0009__x0009_local mid = (lo + hi) // 2_x000A__x0009__x0009_if cumulative[mid] &lt; distance then_x000A__x0009__x0009__x0009_lo = mid + 1_x000A__x0009__x0009_else_x000A__x0009__x0009__x0009_hi = mid_x000A__x0009__x0009_end_x000A__x0009_end_x000A__x0009_return lo_x000A_end_x000A__x000A_--- Фабрика врага. path — предрассчитанные waypoints; waveNumber — для скейлинга HP._x000A_function EnemyClass.new(kind: Types.EnemyKind, waveNumber: number, path: WaypointData, archetype: Model, parent: Instance): Enemy_x000A__x0009_local stats: Types.EnemyStats = Config.ENEMIES[kind]_x000A__x0009_local hpMult = Config.SCALING.hp(waveNumber)_x000A__x0009_local speedMult = Config.SCALING.speed(waveNumber)_x000A__x000A__x0009_local model = archetype:Clone()_x000A__x0009_local root = model:WaitForChild("HumanoidRootPart") :: BasePart_x000A__x0009_model:PivotTo(CFrame.new(path.positions[1]))_x000A__x0009_model.Parent = parent_x000A__x000A__x0009_-- Анти-фликер: модель не участвует в физике, позиция ставим руками_x000A__x0009_for _, part in model:GetDescendants() do_x000A__x0009__x0009_if part:IsA("BasePart") then_x000A__x0009__x0009__x0009_part.CanCollide = false_x000A__x0009__x0009__x0009_part.CanQuery = true          -- важно: GetPartBoundsInRadius должен её видеть_x000A__x0009__x0009__x0009_part.CanTouch = false_x000A__x0009__x0009__x0009_part.CastShadow = false_x000A__x0009__x0009__x0009_part.AssemblyLinearVelocity = Vector3.zero_x000A__x0009__x0009_end_x000A__x0009_end_x000A__x0009_model:AddTag("Enemy")_x000A__x0009_model:SetAttribute("Flying", stats.flying)_x000A__x0009_model:SetAttribute("Travelled", 0)_x000A__x000A__x0009_local self: Enemy = setmetatable({_x000A__x0009__x0009_kind = kind,_x000A__x0009__x0009_model = model,_x000A__x0009__x0009_humanoidRoot = root,_x000A__x0009__x0009_maxHealth = math.floor(stats.health * hpMult),_x000A__x0009__x0009_health = math.floor(stats.health * hpMult),_x000A__x0009__x0009_baseSpeed = stats.speed * speedMult,_x000A__x0009__x0009_reward = stats.reward,_x000A__x0009__x0009_flying = stats.flying,_x000A__x0009__x0009_coreDamage = stats.coreDamage,_x000A__x0009__x0009_travelledDistance = 0,_x000A__x0009__x0009_alive = true,_x000A__x0009__x0009_reachedEnd = false,_x000A__x0009_}, EnemyClass)_x000A__x000A__x0009_-- приватные данные храним в weak-tables вне публичного типа_x000A__x0009_self._path = path_x000A__x0009_self._slowUntil = 0_x000A__x0009_self._slowPercent = 0_x000A__x0009_return self_x000A_end_x000A__x000A_function EnemyClass.getCurrentSpeed(self: Enemy): number_x000A__x0009_local now = os.clock()_x000A__x0009_if now &lt; (self._slowUntil or 0) then_x000A__x0009__x0009_local resist = Config.ENEMIES[self.kind].slowResist_x000A__x0009__x0009_return self.baseSpeed * (1 - (self._slowPercent or 0) * (1 - resist))_x000A__x0009_end_x000A__x0009_return self.baseSpeed_x000A_end_x000A__x000A_function EnemyClass.applySlow(self: Enemy, percent: number, duration: number)_x000A__x0009_if self.flying and self.kind == "Drone" then_x000A__x0009__x0009_percent = math.min(percent, 0.3) -- дроны слабо замедляются_x000A__x0009_end_x000A__x0009_-- стаки: берём более сильный slow и продлеваем время_x000A__x0009_self._slowPercent = math.max(self._slowPercent or 0, percent)_x000A__x0009_self._slowUntil = math.max(self._slowUntil or 0, os.clock() + duration)_x000A_end_x000A__x000A_--- Вызывается серверным MovementSystem раз в ~30 Гц для всех живых врагов одним циклом._x000A_function EnemyClass.update(self: Enemy, dt: number)_x000A__x0009_if not self.alive then return end_x000A__x000A__x0009_self.travelledDistance += self:getCurrentSpeed() * dt_x000A__x0009_local path = self._path :: WaypointData_x000A__x000A__x0009_if self.travelledDistance &gt;= path.totalLength then_x000A__x0009__x0009_self.reachedEnd = true_x000A__x0009__x0009_self.alive = false_x000A__x0009__x0009_return_x000A__x0009_end_x000A__x000A__x0009_-- LUT-интерполяция позиции_x000A__x0009_local seg = findSegment(path.cumulative, self.travelledDistance)_x000A__x0009_local a, b = path.positions[seg], path.positions[seg + 1]_x000A__x0009_local segLen = path.cumulative[seg + 1] - path.cumulative[seg]_x000A__x0009_local alpha = if segLen &gt; 0 then (self.travelledDistance - path.cumulative[seg]) / segLen else 0_x000A__x0009_local pos = a:Lerp(b, math.clamp(alpha, 0, 1))_x000A__x000A__x0009_-- Летающие идут по «воздушной» высоте и срезают углы_x000A__x0009_if self.flying then_x000A__x0009__x0009_pos = pos + Vector3.new(0, 6, 0)_x000A__x0009__x0009_self.model:PivotTo(CFrame.lookAt(pos, b + Vector3.new(0, 6, 0)))_x000A__x0009_else_x000A__x0009__x0009_self.model:PivotTo(CFrame.lookAt(pos, b))_x000A__x0009_end_x000A__x000A__x0009_self.model:SetAttribute("Travelled", self.travelledDistance) -- для таргетинга First/Last_x000A_end_x000A__x000A_--- Возвращает true, если враг умер от этого урона._x000A_function EnemyClass.takeDamage(self: Enemy, amount: number, _source: Instance?): boolean_x000A__x0009_if not self.alive then return false end_x000A__x0009_self.health -= amount_x000A__x0009_if self.health &lt;= 0 then_x000A__x0009__x0009_self.health = 0_x000A__x0009__x0009_self.alive = false_x000A__x0009__x0009_return true_x000A__x0009_end_x000A__x0009_return false_x000A_end_x000A__x000A_function EnemyClass.destroy(self: Enemy)_x000A__x0009_self._path = nil_x000A__x0009_self._slowUntil = nil_x000A__x0009_self._slowPercent = nil_x000A_end_x000A__x000A_return EnemyClass_x000A_</ProtectedString></Properties></Item></Children></Item><Item class="Folder" Referent="RBX000005"><Properties><string name="Name">Projectile</string></Properties><Children><Item class="ModuleScript" Referent="RBX000003"><Properties><string name="Name">Pool</string><ProtectedString name="Source">--!strict_x000A_-- Pool.lua — generic object pool для моделей (враги, снаряды, VFX)._x000A_-- ReplicatedStorage.Modules.Projectile.Pool_x000A_--_x000A_-- Проблема без пула: на каждой волне сотни Instance.new/Clone + Destroy -&gt;_x000A_-- spikes сборщика мусора и просадки репликации. Пул переиспользует модели:_x000A_-- Release() убирает их в «карман» ниже карты (Parent = storage), Get() достаёт._x000A__x000A_export type Pool = {_x000A__x0009_get: (self: Pool) -&gt; Model?,           -- nil, если пул пуст (создавайте через prefill)_x000A__x0009_release: (self: Pool, obj: Model) -&gt; (),_x000A__x0009_size: (self: Pool) -&gt; number,_x000A__x0009_prefill: (self: Pool, count: number) -&gt; (),_x000A_}_x000A__x000A_local PoolClass = {}_x000A_PoolClass.__index = PoolClass_x000A__x000A_--- archetype: шаблон-модель (ReplicatedStorage.Asets...), storage: хранилище неактивных объектов_x000A_function PoolClass.new(archetype: Model, storage: Folder, maxIdle: number?): Pool_x000A__x0009_local self = setmetatable({_x000A__x0009__x0009__archetype = archetype,_x000A__x0009__x0009__storage = storage,_x000A__x0009__x0009__free = {} :: {Model},_x000A__x0009__x0009__maxIdle = maxIdle or 50,_x000A__x0009_}, PoolClass) :: any_x000A__x0009_return self :: Pool_x000A_end_x000A__x000A_function PoolClass.get(self: Pool): Model?_x000A__x0009_local free = (self :: any)._free :: {Model}_x000A__x0009_local n = #free_x000A__x0009_if n == 0 then_x000A__x0009__x0009_return nil -- пул исчерпан: сервер должен создать новый или дождаться release_x000A__x0009_end_x000A__x0009_local obj = free[n]_x000A__x0009_table.remove(free)_x000A__x0009_obj:PivotTo(CFrame.identity)_x000A__x0009_return obj_x000A_end_x000A__x000A_function PoolClass.release(self: Pool, obj: Model)_x000A__x0009_local free = (self :: any)._free :: {Model}_x000A__x0009_if #free &gt;= (self :: any)._maxIdle then_x000A__x0009__x0009_obj:Destroy() -- пул переполнен — реально удаляем_x000A__x0009__x0009_return_x000A__x0009_end_x000A__x0009_-- чистим состояние перед возвратом в пул_x000A__x0009_for _, d in obj:GetDescendants() do_x000A__x0009__x0009_if d:IsA("BasePart") then_x000A__x0009__x0009__x0009_d.AssemblyLinearVelocity = Vector3.zero_x000A__x0009__x0009__x0009_d.AssemblyAngularVelocity = Vector3.zero_x000A__x0009__x0009_end_x000A__x0009_end_x000A__x0009_obj.Parent = (self :: any)._storage :: Folder_x000A__x0009_table.insert(free, obj)_x000A_end_x000A__x000A_function PoolClass.size(self: Pool): number_x000A__x0009_return #(self :: any)._free :: {Model}_x000A_end_x000A__x000A_--- Предзаполнение: вызывается на запуске сервера, чтобы первые волны были без аллокаций_x000A_function PoolClass.prefill(self: Pool, count: number)_x000A__x0009_for _ = 1, count do_x000A__x0009__x0009_local clone = ((self :: any)._archetype :: Model):Clone()_x000A__x0009__x0009_clone.Parent = (self :: any)._storage :: Folder_x000A__x0009__x0009_table.insert((self :: any)._free :: {Model}, clone)_x000A__x0009_end_x000A_end_x000A__x000A_return PoolClass_x000A_</ProtectedString></Properties></Item><Item class="ModuleScript" Referent="RBX000004"><Properties><string name="Name">Projectile</string><ProtectedString name="Source">--!strict_x000A_-- Projectile.lua — снаряд с линейным лерпом (без физики) и пулингом._x000A_-- ReplicatedStorage.Modules.Projectile.Projectile_x000A_--_x000A_-- Снаряд летит из точки A в предсказанную точку B с постоянной скоростью;_x000A_-- по прибытии вызывает onHit(origin, targetPosition). Модель берётся из Pool._x000A__x000A_local Types = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules")_x000A__x0009_:WaitForChild("Shared"):WaitForChild("Types"))_x000A_local PoolModule = require(script.Parent:WaitForChild("Pool"))_x000A_local EnemyModule = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules")_x000A__x0009_:WaitForChild("Enemy"):WaitForChild("Enemy"))_x000A__x000A_type Enemy = EnemyModule.Enemy_x000A__x000A_export type Projectile = {_x000A__x0009_active: boolean,_x000A__x0009_from: Vector3,_x000A__x0009_to: Vector3,_x000A__x0009_speed: number,_x000A__x0009_travelled: number,_x000A__x0009_distance: number,_x000A__x0009_model: Model?,_x000A__x0009_onHit: (from: Vector3, to: Vector3, target: Enemy?) -&gt; (),_x000A__x0009_target: Types.EnemyKind?,_x000A__x0009__targetRef: Enemy?,_x000A_}_x000A__x000A_local ProjectileClass = {}_x000A_ProjectileClass.__index = ProjectileClass_x000A__x000A_local projectilePool: PoolModule.Pool? = nil_x000A__x000A_--- Инициализация пула снарядов (вызвать один раз в Main.server.lua)_x000A_function ProjectileClass.initPool(archetype: Model, storage: Folder)_x000A__x0009_projectilePool = PoolModule.new(archetype, storage, 200)_x000A__x0009_projectilePool:prefill(60)_x000A_end_x000A__x000A_function ProjectileClass.fire(_x000A__x0009_from: Vector3,_x000A__x0009_to: Vector3,_x000A__x0009_speed: number,_x000A__x0009_target: Enemy?,_x000A__x0009_onHit: (from: Vector3, to: Vector3, target: Enemy?) -&gt; ()_x000A_): Projectile?_x000A__x0009_if not projectilePool then error("Projectile.initPool was not called") end_x000A__x0009_local model = projectilePool:get()_x000A__x0009_if not model then return nil end -- пул пуст -&gt; graceful skip (визуал важнее, чем лаг)_x000A__x000A__x0009_local dist = (to - from).Magnitude_x000A__x0009_local self: Projectile = setmetatable({_x000A__x0009__x0009_active = true,_x000A__x0009__x0009_from = from,_x000A__x0009__x0009_to = to,_x000A__x0009__x0009_speed = speed,_x000A__x0009__x0009_travelled = 0,_x000A__x0009__x0009_distance = math.max(dist, 0.001),_x000A__x0009__x0009_model = model,_x000A__x0009__x0009_onHit = onHit,_x000A__x0009__x0009_target = if target then target.kind else nil,_x000A__x0009_}, ProjectileClass)_x000A__x000A__x0009_model.Parent = workspace:FindFirstChild("Runtime") or workspace_x000A__x0009_model:PivotTo(CFrame.lookAt(from, to))_x000A__x0009_self._targetRef = target -- сохраняем ссылку: при попадании пересчитаем текущую позицию_x000A__x0009_return self_x000A_end_x000A__x000A_--- Серверный тик: продвигает все активные снаряды. Возвращает true, если снаряд завершился._x000A_function ProjectileClass.update(self: Projectile, dt: number): boolean_x000A__x0009_if not self.active then return true end_x000A__x0009_self.travelled += self.speed * dt_x000A__x0009_local t = self.travelled / self.distance_x000A__x000A__x0009_if t &gt;= 1 then_x000A__x0009__x0009_self.active = false_x000A__x0009__x0009_local target = self._targetRef_x000A__x0009__x0009_self.onHit(self.from, self.to, target)_x000A__x0009__x0009_if self.model and projectilePool then_x000A__x0009__x0009__x0009_projectilePool:release(self.model)_x000A__x0009__x0009_end_x000A__x0009__x0009_self.model = nil_x000A__x0009__x0009_self._targetRef = nil_x000A__x0009__x0009_return true_x000A__x0009_end_x000A__x000A__x0009_-- позиционируем снаряд по пути_x000A__x0009_if self.model then_x000A__x0009__x0009_self.model:PivotTo(CFrame.lookAt(self.from:Lerp(self.to, t), self.to))_x000A__x0009_end_x000A__x0009_return false_x000A_end_x000A__x000A_return ProjectileClass_x000A_</ProtectedString></Properties></Item></Children></Item><Item class="Folder" Referent="RBX000008"><Properties><string name="Name">Shared</string></Properties><Children><Item class="ModuleScript" Referent="RBX000006"><Properties><string name="Name">Config</string><ProtectedString name="Source">--!strict_x000A_-- Config.lua — единый источник баланса (ReplicatedStorage.Modules.Shared)._x000A_-- Сервер и клиент require-ят один модуль =&gt; цифры всегда синхронны._x000A__x000A_local Types = require(script.Parent.Types)_x000A__x000A_local Config = {_x000A__x0009_GAME = {_x000A__x0009__x0009_STARTING_GOLD = 300,_x000A__x0009__x0009_CORE_HP = 20,_x000A__x0009__x0009_TOTAL_WAVES = 30,_x000A__x0009__x0009_INTERMISSION_TIME = 15,_x000A__x0009__x0009_EARLY_CALL_BONUS = 25,_x000A__x0009__x0009_WAVE_BONUS_BASE = 50,_x000A__x0009__x0009_WAVE_BONUS_PER_WAVE = 10,_x000A__x0009__x0009_INTEREST_RATE = 0.05,_x000A__x0009__x0009_INTEREST_CAP = 150,_x000A__x0009__x0009_SELL_REFUND_RATIO = 0.6,_x000A__x0009__x0009_TOWER_TICK_HZ = 10,          -- частота тика башен (сек 0.1)_x000A__x0009__x0009_MOVE_TICK_DT = 1 / 30,       -- серверный цикл движения врагов_x000A__x0009_},_x000A__x000A__x0009_-- Множители сложности по номеру волны_x000A__x0009_SCALING = {_x000A__x0009__x0009_hp = function(wave: number): number_x000A__x0009__x0009__x0009_return 1 + 0.18 * wave + 0.006 * wave ^ 2_x000A__x0009__x0009_end,_x000A__x0009__x0009_speed = function(wave: number): number_x000A__x0009__x0009__x0009_return math.min(1 + 0.012 * wave, 1.45)_x000A__x0009__x0009_end,_x000A__x0009__x0009_reward = function(wave: number): number_x000A__x0009__x0009__x0009_return 1 + 0.02 * wave_x000A__x0009__x0009_end,_x000A__x0009_},_x000A__x000A__x0009_ENEMIES = {_x000A__x0009__x0009_Runner = { health = 45, speed = 12, reward = 8, flying = false, coreDamage = 1, slowResist = 0 } :: Types.EnemyStats,_x000A__x0009__x0009_Golem  = { health = 320, speed = 4.5, reward = 25, flying = false, coreDamage = 2, slowResist = 0.5 } :: Types.EnemyStats,_x000A__x0009__x0009_Drone  = { health = 90, speed = 9, reward = 15, flying = true, coreDamage = 1, slowResist = 0 } :: Types.EnemyStats,_x000A__x0009__x0009_Boss   = { health = 2560, speed = 3.5, reward = 200, flying = false, coreDamage = 5, slowResist = 0.8 } :: Types.EnemyStats,_x000A__x0009_} :: { [Types.EnemyKind]: Types.EnemyStats },_x000A__x000A__x0009_TOWERS = {_x000A__x0009__x0009_Pulse = { cost = 100, damage = 22, cooldown = 0.6, range = 16, splashRadius = 0,_x000A__x0009__x0009_          slowPercent = 0, slowDuration = 0, pierce = 0, defaultTarget = "First",_x000A__x0009__x0009_          hitscan = false, canHitAir = true } :: Types.TowerStats,_x000A__x0009__x0009_Mortar = { cost = 250, damage = 35, cooldown = 1.6, range = 20, splashRadius = 6,_x000A__x0009__x0009_          slowPercent = 0, slowDuration = 0, pierce = 0, defaultTarget = "First",_x000A__x0009__x0009_          hitscan = false, canHitAir = false } :: Types.TowerStats,_x000A__x0009__x0009_Cryo = { cost = 180, damage = 8, cooldown = 0.9, range = 14, splashRadius = 0,_x000A__x0009__x0009_          slowPercent = 0.45, slowDuration = 2, pierce = 0, defaultTarget = "Strongest",_x000A__x0009__x0009_          hitscan = false, canHitAir = true } :: Types.TowerStats,_x000A__x0009__x0009_Railgun = { cost = 400, damage = 180, cooldown = 2.8, range = 34, splashRadius = 0,_x000A__x0009__x0009_          slowPercent = 0, slowDuration = 0, pierce = 1, defaultTarget = "Strongest",_x000A__x0009__x0009_          hitscan = true, canHitAir = true } :: Types.TowerStats,_x000A__x0009_} :: { [Types.TowerKind]: Types.TowerStats },_x000A__x000A__x0009_UPGRADE = {_x000A__x0009__x0009_DAMAGE_MULT = 1.75,_x000A__x0009__x0009_RANGE_MULT = 1.10,_x000A__x0009__x0009_COOLDOWN_MULT = 0.90,_x000A__x0009__x0009_COST_RATIOS = { 0.7, 1.2 }, -- цена апгрейда до L2 и L3 от базы_x000A__x0009__x0009_MAX_LEVEL = 3,_x000A__x0009_},_x000A_}_x000A__x000A_return Config_x000A_</ProtectedString></Properties></Item><Item class="ModuleScript" Referent="RBX000007"><Properties><string name="Name">Types</string><ProtectedString name="Source">--!strict_x000A_-- Types.lua — общие типы для Neon Nexus Defense (ReplicatedStorage.Modules.Shared)_x000A__x000A_export type EnemyKind = "Runner" | "Golem" | "Drone" | "Boss"_x000A_export type TowerKind = "Pulse" | "Mortar" | "Cryo" | "Railgun"_x000A_export type TargetMode = "First" | "Last" | "Strongest" | "Weakest"_x000A__x000A_export type EnemyStats = {_x000A__x0009_health: number,_x000A__x0009_speed: number,          -- studs/sec_x000A__x0009_reward: number,         -- базовое золото_x000A__x0009_flying: boolean,        -- игнорирует ground-only таргетинг Mortar_x000A__x0009_coreDamage: number,     -- урон ядру при доходе_x000A__x0009_slowResist: number,     -- 0..1, доля иммунитета к замедлению_x000A_}_x000A__x000A_export type TowerStats = {_x000A__x0009_cost: number,_x000A__x0009_damage: number,_x000A__x0009_cooldown: number,       -- сек между выстрелами_x000A__x0009_range: number,          -- studs_x000A__x0009_splashRadius: number,   -- 0 = без AoE_x000A__x0009_slowPercent: number,    -- 0 = не стадит_x000A__x0009_slowDuration: number,_x000A__x0009_pierce: number,         -- снайпер: доп. цели на линии_x000A__x0009_defaultTarget: TargetMode,_x000A__x0009_hitscan: boolean,_x000A__x0009_canHitAir: boolean,_x000A_}_x000A__x000A_export type WaveGroup = {_x000A__x0009_kind: EnemyKind,_x000A__x0009_count: number,_x000A__x0009_interval: number,       -- сек между спавнами в группе_x000A__x0009_startDelay: number,     -- запуск группы относительно начала волны_x000A_}_x000A__x000A_export type WaveDefinition = {_x000A__x0009_groups: {WaveGroup},_x000A_}_x000A__x000A_return {_x000A__x0009_EnemyKind = nil :: any, -- type-only placeholder (не используется в рантайме)_x000A_}_x000A_</ProtectedString></Properties></Item></Children></Item><Item class="Folder" Referent="RBX000010"><Properties><string name="Name">Tower</string></Properties><Children><Item class="ModuleScript" Referent="RBX000009"><Properties><string name="Name">Tower</string><ProtectedString name="Source">--!strict_x000A_-- Tower.lua — ООП-класс башни: поиск цели через Spatial Query API и стрельба._x000A_-- ReplicatedStorage.Modules.Tower.Tower_x000A_--_x000A_-- Ключевая оптимизация: вместо перебора всех врагов (O(N) на каждую башню каждый кадр)_x000A_-- используем workspace:GetPartBoundsInRadius — движковый broadphase-запрос за ~O(log N)._x000A_-- Таргетинг First/Last строится на атрибуте "Travelled" (пишет Enemy.update),_x000A_-- Strongest/Weakest — на атрибуте "Health"._x000A__x000A_local ReplicatedStorage = game:GetService("ReplicatedStorage")_x000A_local Shared = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Shared")_x000A_local Config = require(Shared:WaitForChild("Config"))_x000A_local Types = require(Shared:WaitForChild("Types"))_x000A_local EnemyModule = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Enemy"):WaitForChild("Enemy"))_x000A_local ProjectileModule = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Projectile"):WaitForChild("Projectile"))_x000A__x000A_type Enemy = EnemyModule.Enemy_x000A_type TowerKind = Types.TowerKind_x000A_type TargetMode = Types.TargetMode_x000A__x000A_export type Tower = {_x000A__x0009_kind: TowerKind,_x000A__x0009_level: number,_x000A__x0009_model: Model,_x000A__x0009_muzzle: BasePart,_x000A__x0009_cellId: string,_x000A__x0009_ownerUserId: number,_x000A__x0009_targetMode: TargetMode,_x000A__x0009_cooldownLeft: number,_x000A__x0009_stats: Types.TowerStats, -- текущие статы с учётом апгрейдов_x000A__x0009_totalInvested: number,_x000A__x000A__x0009_-- приватные поля (конвенция: underscore = не трогать извне)_x000A__x0009__lastKill: { target: Enemy }?,_x000A__x000A__x0009_upgrade: (self: Tower) -&gt; boolean,_x000A__x0009_getUpgradeCost: (self: Tower) -&gt; number?,_x000A__x0009_findTarget: (self: Tower, registry: { [BasePart]: Enemy }) -&gt; Enemy?,_x000A__x0009_fireAt: (self: Tower, target: Enemy, registry: { [BasePart]: Enemy }) -&gt; (),_x000A__x0009_tick: (self: Tower, dt: number, registry: { [BasePart]: Enemy }) -&gt; (),_x000A_}_x000A__x000A_local TowerClass = {}_x000A_TowerClass.__index = TowerClass_x000A__x000A_-- Переиспользуемый OverlapParams (не создаём новый каждый тик!)_x000A_local function makeOverlapParams(): OverlapParams_x000A__x0009_local params = OverlapParams.new()_x000A__x0009_params.FilterType = Enum.RaycastFilterType.Exclude_x000A__x0009_params.FilterDescendantsInstances = {}_x000A__x0009_params.MaxParts = 128_x000A__x0009_return params_x000A_end_x000A_local _sharedParams = makeOverlapParams()_x000A__x000A_--- Реестр «живой» серверной логики: model part -&gt; Enemy object._x000A_--- Заполняет WaveManager при спавне/смерти. Нужен, чтобы из Part (результат spatial query)_x000A_--- получить объект Enemy для нанесения урона._x000A__x000A_function TowerClass.new(kind: TowerKind, model: Model, cellId: string, ownerUserId: number): Tower_x000A__x0009_local muzzle = model:WaitForChild("Muzzle") :: BasePart_x000A__x0009_local base = Config.TOWERS[kind]_x000A__x0009_local self: Tower = setmetatable({_x000A__x0009__x0009_kind = kind,_x000A__x0009__x0009_level = 1,_x000A__x0009__x0009_model = model,_x000A__x0009__x0009_muzzle = muzzle,_x000A__x0009__x0009_cellId = cellId,_x000A__x0009__x0009_ownerUserId = ownerUserId,_x000A__x0009__x0009_targetMode = base.defaultTarget,_x000A__x0009__x0009_cooldownLeft = 0,_x000A__x0009__x0009_totalInvested = base.cost,_x000A__x0009__x0009_stats = table.clone(base),_x000A__x0009_}, TowerClass)_x000A__x0009_model:SetAttribute("TowerKind", kind)_x000A__x0009_model:SetAttribute("Level", 1)_x000A__x0009_return self_x000A_end_x000A__x000A_--- Пересчёт стата по уровню: damage ×1.75^L, range ×1.1^L, cooldown ×0.9^L_x000A_local function scaledStat(base: number, level: number, mult: number): number_x000A__x0009_return base * mult ^ (level - 1)_x000A_end_x000A__x000A_function TowerClass.getUpgradeCost(self: Tower): number?_x000A__x0009_if self.level &gt;= Config.UPGRADE.MAX_LEVEL then return nil end_x000A__x0009_local ratio = Config.UPGRADE.COST_RATIOS[self.level]_x000A__x0009_return math.floor(Config.TOWERS[self.kind].cost * ratio)_x000A_end_x000A__x000A_function TowerClass.upgrade(self: Tower): boolean_x000A__x0009_local cost = self:getUpgradeCost()_x000A__x0009_if not cost then return false end_x000A__x0009_self.level += 1_x000A__x0009_self.totalInvested += cost_x000A__x0009_local base = Config.TOWERS[self.kind]_x000A__x0009_self.stats.damage = scaledStat(base.damage, self.level, Config.UPGRADE.DAMAGE_MULT)_x000A__x0009_self.stats.range = scaledStat(base.range, self.level, Config.UPGRADE.RANGE_MULT)_x000A__x0009_self.stats.cooldown = scaledStat(base.cooldown, self.level, Config.UPGRADE.COOLDOWN_MULT)_x000A__x0009_self.model:SetAttribute("Level", self.level)_x000A__x0009_return true_x000A_end_x000A__x000A_--- Сортировка-выбор цели по режиму таргетинга среди кандидатов._x000A_local function pickByMode(candidates: { {enemy: Enemy, travelled: number, health: number} }, mode: TargetMode): Enemy?_x000A__x0009_local best: Enemy? = nil_x000A__x0009_local bestKey = 0_x000A__x0009_for _, c in candidates do_x000A__x0009__x0009_local key: number_x000A__x0009__x0009_if mode == "First" then key = c.travelled            -- дальше всех по пути_x000A__x0009__x0009_elseif mode == "Last" then key = -c.travelled        -- ближе к спавну_x000A__x0009__x0009_elseif mode == "Strongest" then key = c.health_x000A__x0009__x0009_else key = -c.health end                              -- Weakest_x000A__x0009__x0009_if best == nil or key &gt; bestKey then_x000A__x0009__x0009__x0009_best, bestKey = c.enemy, key_x000A__x0009__x0009_end_x000A__x0009_end_x000A__x0009_return best_x000A_end_x000A__x000A_--- Поиск цели: GetPartBoundsInRadius + фильтрация + выбор по таргет-моду._x000A_function TowerClass.findTarget(self: Tower, registry: { [BasePart]: Enemy }): Enemy?_x000A__x0009_local origin = self.muzzle.Position_x000A__x0009_local range = self.stats.range_x000A__x000A__x0009_-- SPATIAL QUERY API (современная замена Region3 / GetPartsInRegion3)_x000A__x0009_local parts = workspace:GetPartBoundsInRadius(origin, range, _sharedParams)_x000A__x000A__x0009_local candidates: { {enemy: Enemy, travelled: number, health: number} } = {}_x000A__x0009_for _, part in parts do_x000A__x0009__x0009_local enemy = registry[part]_x000A__x0009__x0009_if enemy and enemy.alive then_x000A__x0009__x0009__x0009_-- Mortar не бьёт летающих; остальные башни бьют всех_x000A__x0009__x0009__x0009_if self.stats.canHitAir or not enemy.flying then_x000A__x0009__x0009__x0009__x0009_table.insert(candidates, {_x000A__x0009__x0009__x0009__x0009__x0009_enemy = enemy,_x000A__x0009__x0009__x0009__x0009__x0009_travelled = enemy.travelledDistance,_x000A__x0009__x0009__x0009__x0009__x0009_health = enemy.health,_x000A__x0009__x0009__x0009__x0009_})_x000A__x0009__x0009__x0009_end_x000A__x0009__x0009_end_x000A__x0009_end_x000A__x000A__x0009_return pickByMode(candidates, self.targetMode)_x000A_end_x000A__x000A_--- Предсказание точки перехвата: куда враг придёт за время полёта снаряда._x000A_local function predictPosition(target: Enemy, projSpeed: number, from: Vector3): Vector3_x000A__x0009_local pos = target.model:GetPivot().Position_x000A__x0009_local dist = (pos - from).Magnitude_x000A__x0009_local leadTime = dist / projSpeed_x000A__x0009_-- грубая предикция вдоль пути: + speed*leadTime дистанции =&gt; берём позицию чуть вперёд_x000A__x0009_local ahead = math.min(target.travelledDistance + target:getCurrentSpeed() * leadTime, 1e9)_x000A__x0009_local _ = ahead -- точная LUT-предикция делается в Enemy; здесь упрощённый lead_x000A__x0009_return pos_x000A_end_x000A__x000A_function TowerClass.fireAt(self: Tower, target: Enemy, _registry: { [BasePart]: Enemy })_x000A__x0009_local stats = self.stats_x000A__x0009_local from = self.muzzle.Position_x000A__x000A__x0009_if stats.hitscan then_x000A__x0009__x0009_-- Railgun: мгновенный луч, урон сразу + pierce по линии_x000A__x0009__x0009_local died = target:takeDamage(stats.damage, self.model)_x000A__x0009__x0009_self._lastKill = died and { target = target } or nil_x000A__x0009__x0009_-- TODO VFX Beam через RemoteEvent EnemyFX (клиенты рисуют линию от-&gt;до)_x000A__x0009__x0009_return_x000A__x0009_end_x000A__x000A__x0009_local projSpeed = if self.kind == "Mortar" then 40 else 80_x000A__x0009_local to = predictPosition(target, projSpeed, from)_x000A__x000A__x0009_ProjectileModule.fire(from, to, projSpeed, target, function(_f, hitPos, tgt)_x000A__x0009__x0009_if tgt and tgt.alive then_x000A__x0009__x0009__x0009_if stats.splashRadius &gt; 0 then_x000A__x0009__x0009__x0009__x0009_-- AoE: второй spatial query уже в точке взрыва_x000A__x0009__x0009__x0009__x0009_local params = makeOverlapParams()_x000A__x0009__x0009__x0009__x0009_local boomParts = workspace:GetPartBoundsInRadius(hitPos, stats.splashRadius, params)_x000A__x0009__x0009__x0009__x0009_for _, p in boomParts do_x000A__x0009__x0009__x0009__x0009__x0009_local e = _registry[p]_x000A__x0009__x0009__x0009__x0009__x0009_if e and e.alive and (not e.flying) then_x000A__x0009__x0009__x0009__x0009__x0009__x0009_e:takeDamage(stats.damage, self.model)_x000A__x0009__x0009__x0009__x0009__x0009_end_x000A__x0009__x0009__x0009__x0009_end_x000A__x0009__x0009__x0009_else_x000A__x0009__x0009__x0009__x0009_tgt:takeDamage(stats.damage, self.model)_x000A__x0009__x0009__x0009_end_x000A__x0009__x0009__x0009_if stats.slowPercent &gt; 0 then_x000A__x0009__x0009__x0009__x0009_tgt:applySlow(stats.slowPercent, stats.slowDuration)_x000A__x0009__x0009__x0009_end_x000A__x0009__x0009_end_x000A__x0009_end)_x000A_end_x000A__x000A_--- Тик вызывается TowerSystem раз в 0.1 сек для каждой башни._x000A_function TowerClass.tick(self: Tower, dt: number, registry: { [BasePart]: Enemy })_x000A__x0009_self.cooldownLeft -= dt_x000A__x0009_if self.cooldownLeft &gt; 0 then return end_x000A__x000A__x0009_local target = self:findTarget(registry)_x000A__x0009_if target then_x000A__x0009__x0009_self:fireAt(target, registry)_x000A__x0009__x0009_self.cooldownLeft = self.stats.cooldown_x000A__x0009_end_x000A_end_x000A__x000A_return TowerClass_x000A_</ProtectedString></Properties></Item></Children></Item></Children></Item></Children></Item></classmain>
<classmain class="ServerScriptService"><Item class="ServerScriptService" Referent="RBX000020"><Properties><string name="Name">ServerScriptService</string></Properties><Children><Item class="Folder" Referent="RBX000015"><Properties><string name="Name">Server</string></Properties><Children><Item class="Script" Referent="RBX000012"><Properties><string name="Name">Main</string><ProtectedString name="Source">--!strict_x000A_-- Main.server.lua — bootstrap: создаёт Remotes, папки Runtime, запускает системы._x000A_-- ВАЖНО: WaveManager требует существующие RemoteEvents, поэтому они создаются ЗДЕСЬ,_x000A_-- до require(WaveManager). В проде можно задать их прямо в Studio через Explorer._x000A__x000A_local ReplicatedStorage = game:GetService("ReplicatedStorage")_x000A__x000A_---------------------------------------------------------------------------_x000A_-- 1. Remotes (Folder ReplicatedStorage.Remotes)_x000A_---------------------------------------------------------------------------_x000A_local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes") or Instance.new("Folder")_x000A_remotesFolder.Name = "Remotes"_x000A_remotesFolder.Parent = ReplicatedStorage_x000A__x000A_local function ensureRemote(name: string, className: string): Instance_x000A__x0009_local existing = remotesFolder:FindFirstChild(name)_x000A__x0009_if existing then return existing end_x000A__x0009_local inst = Instance.new(className)_x000A__x0009_inst.Name = name_x000A__x0009_inst.Parent = remotesFolder_x000A__x0009_return inst_x000A_end_x000A__x000A_ensureRemote("TowerActions", "RemoteEvent")     -- C-&gt;S: buy/upgrade/sell/setTarget_x000A_ensureRemote("WaveEvents", "RemoteEvent")       -- S-&gt;All: waveStarted/completed/countdown/gameOver_x000A_ensureRemote("EconomyUpdate", "RemoteEvent")    -- S-&gt;C: золотые события (только владельцу)_x000A_ensureRemote("EnemyFX", "RemoteEvent")          -- S-&gt;All: визуальные события_x000A_ensureRemote("RequestWaveStart", "RemoteFunction") -- C-&gt;S: early call_x000A__x000A_---------------------------------------------------------------------------_x000A_-- 2. Runtime-папки (Workspace)_x000A_---------------------------------------------------------------------------_x000A_local runtime = workspace:FindFirstChild("Runtime") or Instance.new("Folder")_x000A_runtime.Name = "Runtime"_x000A_runtime.Parent = workspace_x000A__x000A_for _, sub in { "EnemyPool", "ProjectilePool", "Towers" } do_x000A__x0009_if not runtime:FindFirstChild(sub) then_x000A__x0009__x0009_local f = Instance.new("Folder")_x000A__x0009__x0009_f.Name = sub_x000A__x0009__x0009_f.Parent = runtime_x000A__x0009_end_x000A_end_x000A__x000A_---------------------------------------------------------------------------_x000A_-- 3. Экономика (общий co-op банк; серверный авторитет)_x000A_---------------------------------------------------------------------------_x000A_local EconomyManager = {}_x000A_EconomyManager.gold = 0 :: number_x000A__x000A_local TowerActions = remotesFolder:WaitForChild("TowerActions") :: RemoteEvent_x000A_local EconomyUpdate = remotesFolder:WaitForChild("EconomyUpdate") :: RemoteEvent_x000A__x000A_local function broadcastGold()_x000A__x0009_for _, player in game:GetService("Players"):GetPlayers() do_x000A__x0009__x0009_EconomyUpdate:FireClient(player, "set", EconomyManager.gold)_x000A__x0009_end_x000A_end_x000A__x000A_game:GetService("Players").PlayerAdded:Connect(function()_x000A__x0009_task.delay(0.5, broadcastGold) -- отдать текущий баланс новому игроку_x000A_end)_x000A__x000A_EconomyUpdate.OnServerEvent:Connect(function(_player, kind: string, amount: number)_x000A__x0009_-- этот канал используется ТОЛЬКО сервером на запись; входящие игнорируем (анти-exploit)_x000A_end)_x000A__x000A_-- Реальный источник начислений — вызовы из WaveManager идут через FireClient выше;_x000A_-- для однопользовательского банка слушаем собственный сигнал:_x000A_local function award(amount: number)_x000A__x0009_EconomyManager.gold += amount_x000A__x0009_broadcastGold()_x000A_end_x000A_local function trySpend(amount: number): boolean_x000A__x0009_if EconomyManager.gold &lt; amount then return false end_x000A__x0009_EconomyManager.gold -= amount_x000A__x0009_broadcastGold()_x000A__x0009_return true_x000A_end_x000A__x000A_---------------------------------------------------------------------------_x000A_-- 4. Башни: реестр клеток + обработка действий клиента с полной валидацией_x000A_---------------------------------------------------------------------------_x000A_local Modules = ReplicatedStorage:WaitForChild("Modules")_x000A_local Config = require(Modules:WaitForChild("Shared"):WaitForChild("Config"))_x000A_local Types = require(Modules:WaitForChild("Shared"):WaitForChild("Types"))_x000A_local TowerModule = require(Modules:WaitForChild("Tower"):WaitForChild("Tower"))_x000A__x000A_type TowerKind = Types.TowerKind_x000A__x000A_local towersByCell: { [string]: TowerModule.Tower } = {}_x000A_local towerArchetypes = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Towers")_x000A_local towersFolder = runtime:WaitForChild("Towers")_x000A__x000A_-- rate-limit против спама запросами_x000A_local lastActionAt: { [number]: number } = {}_x000A_local function rateLimited(userId: number): boolean_x000A__x0009_local now = os.clock()_x000A__x0009_if now - (lastActionAt[userId] or 0) &lt; 0.15 then return true end_x000A__x0009_lastActionAt[userId] = now_x000A__x0009_return false_x000A_end_x000A__x000A_TowerActions.OnServerEvent:Connect(function(player: Player, action: string, ...)_x000A__x0009_if rateLimited(player.UserId) then return end_x000A__x0009_local args = { ... }_x000A__x000A__x0009_if action == "buy" then_x000A__x0009__x0009_local kind, cellId = args[1] :: TowerKind, args[2] :: string_x000A__x0009__x0009_local cell = workspace:FindFirstChild("BuildGrid"):FindFirstChild(cellId)_x000A__x0009__x0009_if not cell then return end                                  -- клетки с таким id нет_x000A__x0009__x0009_if towersByCell[cellId] then return end                      -- клетка занята_x000A__x0009__x0009_if (cell.Position - player.Character:GetPivot().Position).Magnitude &gt; 60 then_x000A__x0009__x0009__x0009_return                                                   -- слишком далеко от строителя_x000A__x0009__x0009_end_x000A__x0009__x0009_local cost = Config.TOWERS[kind].cost_x000A__x0009__x0009_if not trySpend(cost) then return end                        -- не хватает золота_x000A__x000A__x0009__x0009_local archetype = towerArchetypes:FindFirstChild(kind) :: Model?_x000A__x0009__x0009_if not archetype then return end_x000A__x0009__x0009_local model = archetype:Clone()_x000A__x0009__x0009_model:PivotTo(cell.CFrame)_x000A__x0009__x0009_model.Parent = towersFolder_x000A__x000A__x0009__x0009_local tower = TowerModule.new(kind, model, cellId, player.UserId)_x000A__x0009__x0009_tower.totalInvested = cost_x000A__x0009__x0009_towersByCell[cellId] = tower_x000A__x000A__x0009_elseif action == "upgrade" then_x000A__x0009__x0009_local cellId = args[1] :: string_x000A__x0009__x0009_local tower = towersByCell[cellId]_x000A__x0009__x0009_if not tower then return end_x000A__x0009__x0009_local cost = tower:getUpgradeCost()_x000A__x0009__x0009_if cost and trySpend(cost) then_x000A__x0009__x0009__x0009_tower:upgrade()_x000A__x0009__x0009_end_x000A__x000A__x0009_elseif action == "sell" then_x000A__x0009__x0009_local cellId = args[1] :: string_x000A__x0009__x0009_local tower = towersByCell[cellId]_x000A__x0009__x0009_if not tower then return end_x000A__x0009__x0009_award(math.floor(tower.totalInvested * Config.GAME.SELL_REFUND_RATIO))_x000A__x0009__x0009_towersByCell[cellId] = nil_x000A__x0009__x0009_tower.model:Destroy()_x000A__x000A__x0009_elseif action == "setTarget" then_x000A__x0009__x0009_local cellId, mode = args[1] :: string, args[2] :: Types.TargetMode_x000A__x0009__x0009_local tower = towersByCell[cellId]_x000A__x0009__x0009_if tower and (mode == "First" or mode == "Last" or mode == "Strongest" or mode == "Weakest") then_x000A__x0009__x0009__x0009_tower.targetMode = mode_x000A__x0009__x0009_end_x000A__x0009_end_x000A_end)_x000A__x000A_---------------------------------------------------------------------------_x000A_-- 5. TowerSystem: тик всех башен 10 Гц (registry даёт WaveManager)_x000A_---------------------------------------------------------------------------_x000A_task.spawn(function()_x000A__x0009_-- ждём появления реестра от WaveManager_x000A__x0009_local registry: { [BasePart]: any }? = nil_x000A__x0009_repeat_x000A__x0009__x0009_task.wait(0.5)_x000A__x0009__x0009_registry = _G.NND_partRegistry_x000A__x0009_until registry ~= nil_x000A__x000A__x0009_while true do_x000A__x0009__x0009_task.wait(1 / Config.GAME.TOWER_TICK_HZ)_x000A__x0009__x0009_for _, tower in towersByCell do_x000A__x0009__x0009__x0009_tower:tick(1 / Config.GAME.TOWER_TICK_HZ, registry :: any)_x000A__x0009__x0009_end_x000A__x0009_end_x000A_end)_x000A__x000A_---------------------------------------------------------------------------_x000A_-- 6. Запуск волновой системы_x000A_---------------------------------------------------------------------------_x000A_require(script:WaitForChild("WaveManager"))_x000A_print("[NND] Server bootstrap complete")_x000A_</ProtectedString></Properties></Item><Item class="ModuleScript" Referent="RBX000013"><Properties><string name="Name">PathRuntime</string><ProtectedString name="Source">--!strict_x000A_-- PathRuntime.lua — предрассчёт статического пути из Part'ов Workspace.Waypoints._x000A_-- Вызывается ОДИН раз при старте сервера; дальше только читается._x000A_-- Если путь станет динамическим (мазы, разрушаемые мосты) — сюда же встраивается_x000A_-- PathfindingService:CreatePath(AgentParams) + PathModifiers, но для TD это избыточно._x000A__x000A_local waypointsFolder = workspace:WaitForChild("Waypoints")_x000A__x000A_export type PathData = {_x000A__x0009_positions: {Vector3},_x000A__x0009_cumulative: {number},_x000A__x0009_totalLength: number,_x000A_}_x000A__x000A_local PathRuntime = {}_x000A_local cached: PathData? = nil_x000A__x000A_function PathRuntime.precompute(): PathData_x000A__x0009_-- сортируем части по имени W1, W2, ... (числовой суффикс)_x000A__x0009_local parts: {Part} = {}_x000A__x0009_for _, obj in waypointsFolder:GetChildren() do_x000A__x0009__x0009_if obj:IsA("BasePart") then_x000A__x0009__x0009__x0009_table.insert(parts, obj :: Part)_x000A__x0009__x0009_end_x000A__x0009_end_x000A__x0009_table.sort(parts, function(a, b)_x000A__x0009__x0009_local na = tonumber(a.Name:gmatch("%d+")()) or 0_x000A__x0009__x0009_local nb = tonumber(b.Name:gmatch("%d+")()) or 0_x000A__x0009__x0009_return na &lt; nb_x000A__x0009_end)_x000A__x000A__x0009_local positions: {Vector3} = {}_x000A__x0009_local cumulative: {number} = {}_x000A__x0009_local total = 0_x000A__x0009_for i, part in parts do_x000A__x0009__x0009_table.insert(positions, part.Position)_x000A__x0009__x0009_if i == 1 then_x000A__x0009__x0009__x0009_table.insert(cumulative, 0)_x000A__x0009__x0009_else_x000A__x0009__x0009__x0009_total += (positions[i] - positions[i - 1]).Magnitude_x000A__x0009__x0009__x0009_table.insert(cumulative, total)_x000A__x0009__x0009_end_x000A__x0009_end_x000A__x000A__x0009_cached = { positions = positions, cumulative = cumulative, totalLength = total }_x000A__x0009_return cached_x000A_end_x000A__x000A_function PathRuntime.getPath(): PathData_x000A__x0009_if not cached then return PathRuntime.precompute() end_x000A__x0009_return cached_x000A_end_x000A__x000A_return PathRuntime_x000A_</ProtectedString></Properties></Item><Item class="Script" Referent="RBX000014"><Properties><string name="Name">WaveManager</string><ProtectedString name="Source">--!strict_x000A_-- WaveManager.server.lua — генератор волн, спавн врагов, цикл движения и начисление наград._x000A_-- ServerScriptService.Server.WaveManager_x000A_--_x000A_-- Поток данных:_x000A_--   WaveManager --spawn--&gt; Enemy (через класс Enemy) + registry[part] = enemy_x000A_--   Movement loop (1 цикл на 30 Гц для ВСЕХ врагов; не Heartbeat на врага!)_x000A_--   Смерть -&gt; EconomyManager.awardKill(ownerless: shared co-op pool) -&gt; gold_x000A_--   Дошёл до конца -&gt; урон ядру; все группы отработаны и поле пусто -&gt; waveCompleted_x000A__x000A_local ReplicatedStorage = game:GetService("ReplicatedStorage")_x000A_local ServerScriptService = game:GetService("ServerScriptService")_x000A_local Players = game:GetService("Players")_x000A__x000A_local Modules = ReplicatedStorage:WaitForChild("Modules")_x000A_local Shared = Modules:WaitForChild("Shared")_x000A_local Config = require(Shared:WaitForChild("Config"))_x000A_local Types = require(Shared:WaitForChild("Types"))_x000A_local EnemyModule = require(Modules:WaitForChild("Enemy"):WaitForChild("Enemy"))_x000A_local ProjectileModule = require(Modules:WaitForChild("Projectile"):WaitForChild("Projectile"))_x000A__x000A_type EnemyKind = Types.EnemyKind_x000A_type WaypointData = EnemyModule.WaypointData_x000A_type Enemy = EnemyModule.Enemy_x000A__x000A_local Server = ServerScriptService:WaitForChild("Server")_x000A_local PathRuntime = require(Server:WaitForChild("PathRuntime"))_x000A__x000A_local Remotes = ReplicatedStorage:WaitForChild("Remotes")_x000A_local WaveEvents = Remotes:WaitForChild("WaveEvents") :: RemoteEvent_x000A_local EconomyUpdate = Remotes:WaitForChild("EconomyUpdate") :: RemoteEvent_x000A_local RequestWaveStart = Remotes:WaitForChild("RequestWaveStart") :: RemoteFunction_x000A__x000A_---------------------------------------------------------------------------_x000A_-- Состояние_x000A_---------------------------------------------------------------------------_x000A_local activeEnemies: { [Enemy]: boolean } = {}      -- множество живых объектов_x000A_local partRegistry: { [BasePart]: Enemy } = {}      -- part -&gt; Enemy (для башен/AoE)_x000A_local projectiles: { ProjectileModule.Projectile } = {}_x000A__x000A_local currentWave = 0_x000A_local inIntermission = true_x000A_local coreHP = Config.GAME.CORE_HP_x000A_local gameOver = false_x000A__x000A_local runtimeFolder = workspace:WaitForChild("Runtime")_x000A_local enemyStorage = runtimeFolder:WaitForChild("EnemyPool")   -- неактивные модели_x000A_local enemyArchetypes = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Enemies")_x000A__x000A_-- Пул моделей врагов: переиспользуем вместо Clone/Destroy каждый спавн_x000A_local PoolModule = require(Modules:WaitForChild("Projectile"):WaitForChild("Pool"))_x000A_local enemyPools: { [EnemyKind]: PoolModule.Pool } = {}_x000A_for kind, _ in Config.ENEMIES :: { [EnemyKind]: any } do_x000A__x0009_local archetype = enemyArchetypes:FindFirstChild(kind) :: Model?_x000A__x0009_if archetype then_x000A__x0009__x0009_enemyPools[kind] = PoolModule.new(archetype, enemyStorage, 40)_x000A__x0009__x0009_enemyPools[kind]:prefill(20)_x000A__x0009_end_x000A_end_x000A__x000A_---------------------------------------------------------------------------_x000A_-- Генерация состава волны (процедурно по правилам GDD)_x000A_---------------------------------------------------------------------------_x000A_local function buildWave(wave: number): Types.WaveDefinition_x000A__x0009_local groups: { Types.WaveGroup } = {}_x000A__x000A__x0009_table.insert(groups, {_x000A__x0009__x0009_kind = "Runner",_x000A__x0009__x0009_count = 6 + math.floor(wave * 1.8),_x000A__x0009__x0009_interval = math.max(0.35, 1.1 - wave * 0.02),_x000A__x0009__x0009_startDelay = 0,_x000A__x0009_})_x000A__x0009_if wave &gt;= 4 then_x000A__x0009__x0009_table.insert(groups, {_x000A__x0009__x0009__x0009_kind = "Golem",_x000A__x0009__x0009__x0009_count = 2 + math.floor((wave - 4) / 3),_x000A__x0009__x0009__x0009_interval = 2.2,_x000A__x0009__x0009__x0009_startDelay = 4,_x000A__x0009__x0009_})_x000A__x0009_end_x000A__x0009_if wave &gt;= 7 then_x000A__x0009__x0009_table.insert(groups, {_x000A__x0009__x0009__x0009_kind = "Drone",_x000A__x0009__x0009__x0009_count = 3 + math.floor((wave - 7) / 2),_x000A__x0009__x0009__x0009_interval = 0.9,_x000A__x0009__x0009__x0009_startDelay = 8,_x000A__x0009__x0009_})_x000A__x0009_end_x000A__x0009_if wave % 10 == 0 then -- каждая 10-я волна — босс_x000A__x0009__x0009_table.insert(groups, { kind = "Boss", count = wave // 10, interval = 12, startDelay = 10 })_x000A__x0009_end_x000A__x000A__x0009_return { groups = groups }_x000A_end_x000A__x000A_---------------------------------------------------------------------------_x000A_-- Спавн/смерть_x000A_---------------------------------------------------------------------------_x000A_local function despawnEnemy(enemy: Enemy, killedByTower: boolean)_x000A__x0009_activeEnemies[enemy] = nil_x000A__x0009_partRegistry[enemy.humanoidRoot] = nil_x000A__x0009_enemy:destroy()_x000A__x000A__x0009_if killedByTower then_x000A__x0009__x0009_-- Награда делится на всех игроков (co-op общий банк волны)_x000A__x0009__x0009_local reward = math.floor(enemy.reward * Config.SCALING.reward(currentWave))_x000A__x0009__x0009_for _, player in Players:GetPlayers() do_x000A__x0009__x0009__x0009_EconomyUpdate:FireClient(player, "+kill", reward)_x000A__x0009__x0009_end_x000A__x0009_end_x000A__x000A__x0009_local pool = enemyPools[enemy.kind]_x000A__x0009_if pool then_x000A__x0009__x0009_pool:release(enemy.model)_x000A__x0009_else_x000A__x0009__x0009_enemy.model:Destroy()_x000A__x0009_end_x000A_end_x000A__x000A_local function spawnEnemy(kind: EnemyKind)_x000A__x0009_local path: WaypointData = PathRuntime.getPath()_x000A__x0009_local pool = enemyPools[kind]_x000A__x0009_local model = if pool then pool:get() else nil_x000A__x0009_if not model then_x000A__x0009__x0009_model = (enemyArchetypes:FindFirstChild(kind) :: Model):Clone()_x000A__x0009_end_x000A__x000A__x0009_local enemy = EnemyModule.new(kind, currentWave, path, model, runtimeFolder)_x000A__x0009_activeEnemies[enemy] = true_x000A__x0009_partRegistry[enemy.humanoidRoot] = enemy_x000A_end_x000A__x000A_---------------------------------------------------------------------------_x000A_-- Циклы: движение врагов + снаряды (ОДИН цикл на систему, не на сущность)_x000A_---------------------------------------------------------------------------_x000A_task.spawn(function()_x000A__x0009_local dt = Config.GAME.MOVE_TICK_DT_x000A__x0009_while not gameOver do_x000A__x0009__x0009_task.wait(dt)_x000A__x000A__x0009__x0009_-- движение_x000A__x0009__x0009_for enemy in activeEnemies do_x000A__x0009__x0009__x0009_enemy:update(dt)_x000A__x0009__x0009__x0009_if not enemy.alive then_x000A__x0009__x0009__x0009__x0009_if enemy.reachedEnd then_x000A__x0009__x0009__x0009__x0009__x0009_coreHP -= enemy.coreDamage_x000A__x0009__x0009__x0009__x0009__x0009_warn(`[WaveManager] Core hit! HP={coreHP}`)_x000A__x0009__x0009__x0009__x0009__x0009_despawnEnemy(enemy, false)_x000A__x0009__x0009__x0009__x0009_else_x000A__x0009__x0009__x0009__x0009__x0009_despawnEnemy(enemy, true) -- умер от урона башни_x000A__x0009__x0009__x0009__x0009_end_x000A__x0009__x0009__x0009_end_x000A__x0009__x0009_end_x000A__x000A__x0009__x0009_-- снаряды_x000A__x0009__x0009_local i = 1_x000A__x0009__x0009_while i &lt;= #projectiles do_x000A__x0009__x0009__x0009_if projectiles[i]:update(dt) then_x000A__x0009__x0009__x0009__x0009_table.remove(projectiles, i)_x000A__x0009__x0009__x0009_else_x000A__x0009__x0009__x0009__x0009_i += 1_x000A__x0009__x0009__x0009_end_x000A__x0009__x0009_end_x000A__x000A__x0009__x0009_if coreHP &lt;= 0 then_x000A__x0009__x0009__x0009_gameOver = true_x000A__x0009__x0009__x0009_WaveEvents:FireAllClients("gameOver", currentWave)_x000A__x0009__x0009_end_x000A__x0009_end_x000A_end)_x000A__x000A_-- Реестр part-&gt;enemy публикуем для TowerSystem (другой скрипт читает через эту таблицу)_x000A__G.NND_partRegistry = partRegistry -- TODO: в проде заменить на Dependency Injection через Main_x000A__x000A_---------------------------------------------------------------------------_x000A_-- Волновой цикл_x000A_---------------------------------------------------------------------------_x000A_local function runWave(wave: number)_x000A__x0009_currentWave = wave_x000A__x0009_inIntermission = false_x000A__x0009_WaveEvents:FireAllClients("waveStarted", wave)_x000A__x000A__x0009_local definition = buildWave(wave)_x000A__x000A__x0009_-- параллельные группы спавна_x000A__x0009_local threadsRemaining = 0_x000A__x0009_for _, group in definition.groups do_x000A__x0009__x0009_threadsRemaining += 1_x000A__x0009__x0009_task.spawn(function()_x000A__x0009__x0009__x0009_task.delay(group.startDelay, function()_x000A__x0009__x0009__x0009__x0009_for _ = 1, group.count do_x000A__x0009__x0009__x0009__x0009__x0009_if gameOver then break end_x000A__x0009__x0009__x0009__x0009__x0009_spawnEnemy(group.kind :: EnemyKind)_x000A__x0009__x0009__x0009__x0009__x0009_task.wait(group.interval)_x000A__x0009__x0009__x0009__x0009_end_x000A__x0009__x0009__x0009__x0009_threadsRemaining -= 1_x000A__x0009__x0009__x0009_end)_x000A__x0009__x0009_end)_x000A__x0009_end_x000A__x000A__x0009_-- ждём: все заспавнены и все зачищены_x000A__x0009_while threadsRemaining &gt; 0 and not gameOver do_x000A__x0009__x0009_task.wait(0.2)_x000A__x0009_end_x000A__x0009_repeat_x000A__x0009__x0009_local aliveCount = 0_x000A__x0009__x0009_for _ in activeEnemies do aliveCount += 1 end_x000A__x0009__x0009_task.wait(0.25)_x000A__x0009_until aliveCount == 0 or gameOver_x000A__x000A__x0009_if gameOver then return end_x000A__x000A__x0009_-- бонус за волну + interest_x000A__x0009_local bonus = Config.GAME.WAVE_BONUS_BASE + wave * Config.GAME.WAVE_BONUS_PER_WAVE_x000A__x0009_for _, player in Players:GetPlayers() do_x000A__x0009__x0009_EconomyUpdate:FireClient(player, "+waveBonus", bonus)_x000A__x0009_end_x000A__x0009_WaveEvents:FireAllClients("waveCompleted", wave, bonus)_x000A_end_x000A__x000A_local function intermission(seconds: number)_x000A__x0009_inIntermission = true_x000A__x0009_for t = seconds, 1, -1 do_x000A__x0009__x0009_if gameOver then return end_x000A__x0009__x0009_WaveEvents:FireAllClients("countdown", t)_x000A__x0009__x0009_task.wait(1)_x000A__x0009_end_x000A_end_x000A__x000A_-- Early call: клиент просит начать волну досрочно (только во время intermission)_x000A_RequestWaveStart.OnServerInvoke = function(player: Player)_x000A__x0009_if not inIntermission or gameOver then return false end_x000A__x0009_EconomyUpdate:FireClient(player, "+earlyCall", Config.GAME.EARLY_CALL_BONUS)_x000A__x0009_return true_x000A_end_x000A__x000A_-- Главный игровой луп_x000A_task.spawn(function()_x000A__x0009_PathRuntime.precompute() -- читаем Waypoints один раз при старте_x000A__x0009_ProjectileModule.initPool(_x000A__x0009__x0009_ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Projectiles"):WaitForChild("Bolt") :: Model,_x000A__x0009__x0009_runtimeFolder:WaitForChild("ProjectilePool")_x000A__x0009_)_x000A__x000A__x0009_intermission(5) -- короткая пауза на билд перед волной 1_x000A__x0009_local wave = 1_x000A__x0009_while not gameOver do_x000A__x0009__x0009_runWave(wave)_x000A__x0009__x0009_if gameOver then break end_x000A__x0009__x0009_if wave &gt;= Config.GAME.TOTAL_WAVES and wave % 10 ~= 0 then_x000A__x0009__x0009__x0009_-- endless-режим после 30 волн продолжается бесконечно_x000A__x0009__x0009_end_x000A__x0009__x0009_intermission(Config.GAME.INTERMISSION_TIME)_x000A__x0009__x0009_wave += 1_x000A__x0009_end_x000A_end)_x000A_</ProtectedString></Properties></Item></Children></Item></Children></Item></classmain>
<classmain class="StarterPlayerScripts"><Item class="StarterPlayerScripts" Referent="RBX000021"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Children><Item class="Folder" Referent="RBX000018"><Properties><string name="Name">Client</string></Properties><Children><Item class="LocalScript" Referent="RBX000016"><Properties><string name="Name">HudController</string><ProtectedString name="Source">--!strict_x000A_-- HudController.client.lua — HUD: золото, HP ядра, волна, таймер, кнопка early-call._x000A_-- StarterPlayerScripts.Client.HudController (LocalScript)_x000A__x000A_local Players = game:GetService("Players")_x000A_local ReplicatedStorage = game:GetService("ReplicatedStorage")_x000A_local localPlayer = Players.LocalPlayer_x000A__x000A_local Remotes = ReplicatedStorage:WaitForChild("Remotes")_x000A_local WaveEvents = Remotes:WaitForChild("WaveEvents") :: RemoteEvent_x000A_local EconomyUpdate = Remotes:WaitForChild("EconomyUpdate") :: RemoteEvent_x000A_local RequestWaveStart = Remotes:WaitForChild("RequestWaveStart") :: RemoteFunction_x000A__x000A_---------------------------------------------------------------------------_x000A_-- Построение UI кодом (в проде лучше класть ScreenGui в StarterGui и искать через Wait)_x000A_---------------------------------------------------------------------------_x000A_local gui = Instance.new("ScreenGui")_x000A_gui.Name = "NND_Hud"_x000A_gui.ResetOnSpawn = false_x000A_gui.Parent = localPlayer:WaitForChild("PlayerGui")_x000A__x000A_local function makeLabel(name: string, text: string, pos: UDim2): TextLabel_x000A__x0009_local l = Instance.new("TextLabel")_x000A__x0009_l.Name = name_x000A__x0009_l.Text = text_x000A__x0009_l.Size = UDim2.new(0, 220, 0, 34)_x000A__x0009_l.Position = pos_x000A__x0009_l.BackgroundColor3 = Color3.fromRGB(15, 18, 30)_x000A__x0009_l.BackgroundTransparency = 0.25_x000A__x0009_l.TextColor3 = Color3.fromRGB(0, 255, 200) -- neon_x000A__x0009_l.Font = Enum.Font.Code_x000A__x0009_l.TextSize = 18_x000A__x0009_l.Parent = gui_x000A__x0009_return l_x000A_end_x000A__x000A_local goldLabel = makeLabel("Gold", "💰 0", UDim2.new(0, 16, 0, 16))_x000A_local waveLabel = makeLabel("Wave", "Wave: —", UDim2.new(0, 16, 0, 54))_x000A_local timerLabel = makeLabel("Timer", "", UDim2.new(0, 16, 0, 92))_x000A__x000A_local earlyBtn = Instance.new("TextButton")_x000A_earlyBtn.Name = "EarlyCall"_x000A_earlyBtn.Text = "⚡ START WAVE (+25g)"_x000A_earlyBtn.Size = UDim2.new(0, 200, 0, 40)_x000A_earlyBtn.Position = UDim2.new(0, 16, 0, 130)_x000A_earlyBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 90)_x000A_earlyBtn.TextColor3 = Color3.new(1, 1, 1)_x000A_earlyBtn.Visible = false_x000A_earlyBtn.Parent = gui_x000A__x000A_---------------------------------------------------------------------------_x000A_-- Состояние_x000A_---------------------------------------------------------------------------_x000A_local gold = 0_x000A__x000A_EconomyUpdate.OnClientEvent:Connect(function(kind: string, amount: number)_x000A__x0009_if kind == "set" then_x000A__x0009__x0009_gold = amount_x000A__x0009_elseif kind == "+kill" or kind == "+waveBonus" or kind == "+earlyCall" then_x000A__x0009__x0009_gold += amount_x000A__x0009_end_x000A__x0009_goldLabel.Text = `💰 {gold}`_x000A_end)_x000A__x000A_WaveEvents.OnClientEvent:Connect(function(event: string, a: number?, _b: number?)_x000A__x0009_if event == "waveStarted" then_x000A__x0009__x0009_waveLabel.Text = `Wave: {a} ⚔️`_x000A__x0009__x0009_timerLabel.Text = ""_x000A__x0009__x0009_earlyBtn.Visible = false_x000A__x0009_elseif event == "countdown" then_x000A__x0009__x0009_timerLabel.Text = `Следующая волна: {a}с`_x000A__x0009__x0009_earlyBtn.Visible = true_x000A__x0009_elseif event == "waveCompleted" then_x000A__x0009__x0009_waveLabel.Text = `Wave {a} cleared! +{_b}g`_x000A__x0009_elseif event == "gameOver" then_x000A__x0009__x0009_timerLabel.Text = `☠ CORE BREACHED at wave {a}`_x000A__x0009__x0009_earlyBtn.Visible = false_x000A__x0009_end_x000A_end)_x000A__x000A_earlyBtn.Activated:Connect(function()_x000A__x0009_local ok = RequestWaveStart:InvokeServer()_x000A__x0009_if ok then_x000A__x0009__x0009_earlyBtn.Visible = false_x000A__x0009__x0009_timerLabel.Text = "Волна вызвана досрочно!"_x000A__x0009_end_x000A_end)_x000A_</ProtectedString></Properties></Item><Item class="LocalScript" Referent="RBX000017"><Properties><string name="Name">PlacementUI</string><ProtectedString name="Source">--!strict_x000A_-- PlacementUI.client.lua — выбор клетки и башни, «призрак», отправка намерений серверу._x000A_-- Клиент НИКОГДА не решает сам, можно ли строить: он лишь шлёт (kind, cellId),_x000A_-- сервер валидирует (Main.server.lua). Призрак — чисто визуальный фидбек._x000A__x000A_local ReplicatedStorage = game:GetService("ReplicatedStorage")_x000A_local RunService = game:GetService("RunService")_x000A_local UserInputService = game:GetService("UserInputService")_x000A_local Players = game:GetService("Players")_x000A__x000A_local Types = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Shared"):WaitForChild("Types"))_x000A_local localPlayer = Players.LocalPlayer_x000A_local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Shared"):WaitForChild("Config"))_x000A_local TowerActions = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TowerActions") :: RemoteEvent_x000A__x000A_---------------------------------------------------------------------------_x000A_-- Панель выбора башни (упрощённо — 4 кнопки)_x000A_---------------------------------------------------------------------------_x000A_local gui = Instance.new("ScreenGui")_x000A_gui.Name = "NND_Build"_x000A_gui.ResetOnSpawn = false_x000A_gui.Parent = localPlayer:WaitForChild("PlayerGui")_x000A__x000A_local bar = Instance.new("Frame")_x000A_bar.Size = UDim2.new(0, 440, 0, 70)_x000A_bar.Position = UDim2.new(0.5, -220, 1, -90)_x000A_bar.BackgroundColor3 = Color3.fromRGB(12, 14, 24)_x000A_bar.Parent = gui_x000A__x000A_local selectedKind: Types.TowerKind? = nil_x000A__x000A_local x = 4_x000A_for _, kind in { "Pulse", "Mortar", "Cryo", "Railgun" } do_x000A__x0009_local stats = Config.TOWERS[kind]_x000A__x0009_local btn = Instance.new("TextButton")_x000A__x0009_btn.Name = kind_x000A__x0009_btn.Text = `{kind}\n{stats.cost}g`_x000A__x0009_btn.Size = UDim2.new(0, 105, 0, 62)_x000A__x0009_btn.Position = UDim2.new(0, x, 0, 4)_x000A__x0009_btn.BackgroundColor3 = Color3.fromRGB(30, 36, 60)_x000A__x0009_btn.TextColor3 = Color3.fromRGB(0, 230, 255)_x000A__x0009_btn.AutoButtonColor = true_x000A__x0009_btn.Parent = bar_x000A__x0009_x += 110_x000A__x000A__x0009_btn.Activated:Connect(function()_x000A__x0009__x0009_selectedKind = kind :: Types.TowerKind_x000A__x0009__x0009_for _, sib in bar:GetChildren() do_x000A__x0009__x0009__x0009_if sib:IsA("TextButton") then_x000A__x0009__x0009__x0009__x0009_sib.BackgroundColor3 = if sib == btn_x000A__x0009__x0009__x0009__x0009__x0009_then Color3.fromRGB(0, 120, 100) else Color3.fromRGB(30, 36, 60)_x000A__x0009__x0009__x0009_end_x000A__x0009__x0009_end_x000A__x0009_end)_x000A_end_x000A__x000A_---------------------------------------------------------------------------_x000A_-- Raycast по сетке + призрак_x000A_---------------------------------------------------------------------------_x000A_local ghost: Model? = nil_x000A_local currentCell: BasePart? = nil_x000A__x000A_local params = RaycastParams.new()_x000A_params.FilterType = Enum.RaycastFilterType.Exclude_x000A__x000A_local function refreshGhost()_x000A__x0009_local mousePos = UserInputService:GetMouseLocation()_x000A__x0009_local camera = workspace.CurrentCamera_x000A__x0009_if not camera then return end_x000A__x0009_local ray = camera:ScreenPointToRay(mousePos.X, mousePos.Y)_x000A__x0009_local hit = workspace:Raycast(ray.Origin, ray.Direction * 500, params)_x000A__x000A__x0009_currentCell = nil_x000A__x0009_if hit and hit.Instance.Name:match("^Cell_") and selectedKind then_x000A__x0009__x0009_currentCell = hit.Instance_x000A__x0009__x0009_if not ghost then_x000A__x0009__x0009__x0009_ghost = (ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Towers")_x000A__x0009__x0009__x0009__x0009_:WaitForChild(selectedKind) :: Model):Clone()_x000A__x0009__x0009__x0009_for _, p in ghost:GetDescendants() do_x000A__x0009__x0009__x0009__x0009_if p:IsA("BasePart") then_x000A__x0009__x0009__x0009__x0009__x0009_p.Transparency = 0.5_x000A__x0009__x0009__x0009__x0009__x0009_p.CanCollide, p.CanQuery, p.CanTouch = false, false, false_x000A__x0009__x0009__x0009__x0009_end_x000A__x0009__x0009__x0009_end_x000A__x0009__x0009__x0009_ghost.Parent = workspace_x000A__x0009__x0009_end_x000A__x0009__x0009_ghost:PivotTo(currentCell.CFrame)_x000A__x0009_else_x000A__x0009__x0009_if ghost then ghost:Destroy(); ghost = nil end_x000A__x0009_end_x000A_end_x000A__x000A_RunService.RenderStepped:Connect(refreshGhost)_x000A__x000A_UserInputService.InputBegan:Connect(function(input, processed)_x000A__x0009_if processed or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end_x000A__x0009_if selectedKind and currentCell then_x000A__x0009__x0009_-- отправляем НАМЕРЕНИЕ; сервер проверит деньги/дальность/занятость_x000A__x0009__x0009_TowerActions:FireServer("buy", selectedKind, currentCell.Name)_x000A__x0009_end_x000A_end)_x000A_</ProtectedString></Properties></Item></Children></Item></Children></Item></classmain>
</roblox>
